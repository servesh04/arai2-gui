{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariagui.invalid/browser-contract/v1.schema.json",
  "title": "AriaGUI browser handoff v1",
  "$comment": "Normative parser additionally rejects duplicate properties, malformed UTF-8, noncanonical/zero UUIDs, unsafe URL controls/user-info/escapes and Windows reserved filenames. Maximum UTF-8 body 65536 bytes, JSON depth 8. No extension property bag is allowed.",
  "oneOf": [{"$ref":"#/$defs/request"}, {"$ref":"#/$defs/response"}],
  "$defs": {
    "protocol": {"type":"object","additionalProperties":false,"required":["major","minor"],"properties":{"major":{"const":1},"minor":{"type":"integer","minimum":0,"maximum":2147483647}}},
    "uuid": {"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$","not":{"const":"00000000-0000-0000-0000-000000000000"}},
    "version": {"type":"string","maxLength":64,"pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "hello": {"type":"object","additionalProperties":false,"required":["installationId","extensionVersion"],"properties":{"installationId":{"$ref":"#/$defs/uuid"},"extensionVersion":{"$ref":"#/$defs/version"}}},
    "get": {"type":"object","additionalProperties":false,"required":["installationId","createdAt","sourceUrl","trigger"],"properties":{"installationId":{"$ref":"#/$defs/uuid"},"createdAt":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$"},"sourceUrl":{"type":"string","minLength":1,"maxLength":16384,"x-maxUtf8Bytes":16384,"pattern":"^[Hh][Tt][Tt][Pp][Ss]?://"},"suggestedFileName":{"type":"string","minLength":1,"maxLength":240,"x-lengthUnits":"UTF-16 code units","pattern":"^[^<>:\"/\\\\|?*\\u0000-\\u001f]+$"},"trigger":{"const":"linkContextMenu"}}},
    "status": {"type":"object","additionalProperties":false,"required":["installationId","targetRequestId"],"properties":{"installationId":{"$ref":"#/$defs/uuid"},"targetRequestId":{"$ref":"#/$defs/uuid"}}},
    "request": {"oneOf":[
      {"type":"object","additionalProperties":false,"required":["protocol","requestId","action","payload"],"properties":{"protocol":{"$ref":"#/$defs/protocol"},"requestId":{"$ref":"#/$defs/uuid"},"action":{"const":"hello"},"payload":{"$ref":"#/$defs/hello"}}},
      {"type":"object","additionalProperties":false,"required":["protocol","requestId","action","payload"],"properties":{"protocol":{"$ref":"#/$defs/protocol"},"requestId":{"$ref":"#/$defs/uuid"},"action":{"const":"addPublicGet"},"payload":{"$ref":"#/$defs/get"}}},
      {"type":"object","additionalProperties":false,"required":["protocol","requestId","action","payload"],"properties":{"protocol":{"$ref":"#/$defs/protocol"},"requestId":{"$ref":"#/$defs/uuid"},"action":{"const":"getRequestStatus"},"payload":{"$ref":"#/$defs/status"}}}
    ]},
    "result": {"oneOf":[
      {"type":"object","additionalProperties":false,"required":["code","appVersion","capabilities","maxMessageBytes"],"properties":{"code":{"const":"ready"},"appVersion":{"$ref":"#/$defs/version"},"capabilities":{"type":"array","maxItems":2,"uniqueItems":true,"items":{"enum":["addPublicGet","getRequestStatus"]}},"maxMessageBytes":{"type":"integer","minimum":1,"maximum":65536}}},
      {"type":"object","additionalProperties":false,"required":["code","jobId","state","duplicate"],"properties":{"code":{"const":"accepted"},"jobId":{"$ref":"#/$defs/uuid"},"state":{"enum":["queued","active","paused","completed","failed","interrupted","engine_uncertain","removed"]},"duplicate":{"type":"boolean"}}},
      {"type":"object","additionalProperties":false,"required":["code","reason"],"properties":{"code":{"const":"rejected"},"reason":{"enum":["unsupported_protocol","invalid_request","unsupported_url","invalid_filename","destination_conflict","destination_unavailable","integration_disabled","not_ready","shutting_down","busy","storage_unavailable","request_id_conflict"]}}},
      {"type":"object","additionalProperties":false,"required":["code","retryAfterMs"],"properties":{"code":{"const":"processing"},"retryAfterMs":{"type":"integer","minimum":1,"maximum":10000}}},
      {"type":"object","additionalProperties":false,"required":["code"],"properties":{"code":{"enum":["not_found","expired","unavailable","unknown"]}}}
    ]},
    "response": {"type":"object","additionalProperties":false,"required":["protocol","requestId","result"],"properties":{"protocol":{"$ref":"#/$defs/protocol"},"requestId":{"$ref":"#/$defs/uuid"},"result":{"$ref":"#/$defs/result"}}}
  }
}
