<UserControl x:Class="AriaGui.App.Views.Settings.NotificationsSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="{StaticResource AriaSpace1}"
                 Message="Transfer updates remain in the notification center even when desktop alerts are off." />

        <Border Style="{StaticResource AriaCardStyle}" Margin="{StaticResource AriaSpace1}">
            <StackPanel>
                <TextBlock Text="Desktop alerts" Style="{StaticResource AriaBodyTextStyle}" FontWeight="SemiBold" Margin="{StaticResource AriaSpace1}" />
                <ToggleSwitch Header="Show desktop notifications"
                              IsOn="{Binding NotificationDesktopEnabled, Mode=TwoWay}"
                              Margin="{StaticResource AriaSpace1}" AutomationProperties.Name="Show desktop notifications" />
                <ToggleSwitch Header="Completed transfers"
                              IsOn="{Binding NotificationCompletedEnabled, Mode=TwoWay}"
                              Margin="{StaticResource AriaSpace1}" AutomationProperties.Name="Completed transfer notifications" />
                <ToggleSwitch Header="Failed transfers"
                              IsOn="{Binding NotificationFailedEnabled, Mode=TwoWay}"
                              Margin="{StaticResource AriaSpace1}" AutomationProperties.Name="Failed transfer notifications" />
                <ToggleSwitch Header="Engine needs attention"
                              IsOn="{Binding NotificationEngineEnabled, Mode=TwoWay}"
                              Margin="{StaticResource AriaSpace1}" AutomationProperties.Name="Engine attention notifications" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource AriaCardStyle}" Margin="{StaticResource AriaSpace1}">
            <StackPanel>
                <TextBlock Text="Privacy and timing" Style="{StaticResource AriaBodyTextStyle}" FontWeight="SemiBold" Margin="{StaticResource AriaSpace1}" />
                <ToggleSwitch Header="Hide file names in desktop notifications"
                              IsOn="{Binding NotificationHideFileNames, Mode=TwoWay}"
                              Margin="{StaticResource AriaSpace1}" AutomationProperties.Name="Hide file names in desktop notifications" />
                <ToggleSwitch Header="Show desktop alerts only when AriaGUI is inactive"
                              IsOn="{Binding NotificationOnlyWhenInactive, Mode=TwoWay}"
                              Margin="{StaticResource AriaSpace1}" AutomationProperties.Name="Show desktop alerts only when AriaGUI is inactive" />
                <TextBlock Text="Recent alerts are grouped. Older alerts stay in the notification center without appearing on the desktop."
                           TextWrapping="Wrap" Style="{StaticResource AriaMetadataTextStyle}"
                           Margin="{StaticResource AriaSpace1}" />
            </StackPanel>
        </Border>

        <HyperlinkButton Content="Reset this section to defaults" Click="ResetClick"
                         HorizontalAlignment="Left" Margin="{StaticResource AriaSpace1}" />
    </StackPanel>
</UserControl>
