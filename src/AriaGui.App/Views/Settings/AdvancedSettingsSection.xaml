<UserControl x:Class="AriaGui.App.Views.Settings.AdvancedSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Margin="{StaticResource AriaSpace1}"
                 Message="RPC and saved-session settings are not available yet. Future changes here may require an engine restart." />
        <TextBox Header="RPC endpoint" IsEnabled="False" ToolTipService.ToolTip="RPC endpoint settings are not available in this build."
                 AutomationProperties.Name="RPC endpoint" Margin="{StaticResource AriaSpace1}" HorizontalAlignment="Stretch" />
        <ToggleSwitch Header="Persist download session" IsEnabled="False" ToolTipService.ToolTip="Session persistence is not available in this build."
                      OffContent="Off" OnContent="On" AutomationProperties.Name="Persist download session" Margin="{StaticResource AriaSpace1}" />
        <HyperlinkButton Content="Reset this section to defaults" IsEnabled="False" ToolTipService.ToolTip="No saved settings exist in this section yet."
                         HorizontalAlignment="Left" Margin="{StaticResource AriaSpace1}" />
    </StackPanel>
</UserControl>
