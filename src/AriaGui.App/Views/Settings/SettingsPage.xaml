<Page x:Class="AriaGui.App.Views.Settings.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:icons="using:AriaGui.App.Icons"
      SizeChanged="PageSizeChanged">
    <Grid Padding="{StaticResource AriaSpace4}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="{StaticResource AriaSpace2}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="CompactBackButton" Visibility="Collapsed" Click="CompactBackClick" Style="{StaticResource AriaToolbarButtonStyle}" ToolTipService.ToolTip="Back to downloads" AutomationProperties.Name="Back to downloads">
                <icons:FluentIcon IconName="Back" AutomationProperties.AccessibilityView="Raw" />
            </Button>
            <TextBlock Grid.Column="1" Text="Settings" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <SelectorBar x:Name="SectionTabs" HorizontalAlignment="Left" SelectionChanged="SectionChanged" AutomationProperties.Name="Settings sections">
                <SelectorBarItem Text="General" /><SelectorBarItem Text="Appearance" /><SelectorBarItem Text="Downloads" /><SelectorBarItem Text="Network" />
                <SelectorBarItem Text="BitTorrent" /><SelectorBarItem Text="Integration" /><SelectorBarItem Text="Advanced" /><SelectorBarItem Text="About" />
            </SelectorBar>
        </ScrollViewer>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Spacing="8">
                <Grid>
                    <TextBlock x:Name="SectionTitle" Text="General" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{ThemeResource AriaTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                </Grid>
                <ContentControl x:Name="SectionContent" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
