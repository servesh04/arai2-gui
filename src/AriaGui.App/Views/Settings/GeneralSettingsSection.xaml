<UserControl x:Class="AriaGui.App.Views.Settings.GeneralSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="{StaticResource AriaSpace1}"
                 Message="Sign-in launch and notification-area preferences are not available in this build. Downloads continue while the window is closed." />

        <StackPanel Margin="{StaticResource AriaSpace1}">
            <TextBlock Text="Launch at sign-in" Style="{StaticResource AriaBodyTextStyle}" Margin="{StaticResource AriaSpace1}" />
            <TextBlock Text="Start AriaGUI when you sign in to Windows." Style="{StaticResource AriaMetadataTextStyle}" TextWrapping="Wrap" Margin="{StaticResource AriaSpace1}" />
            <ToggleSwitch OffContent="Off" OnContent="On" IsEnabled="False"
                          ToolTipService.ToolTip="Starting AriaGUI at sign-in is not supported in this build."
                          AutomationProperties.Name="Launch at sign-in" Margin="{StaticResource AriaSpace1}" />
        </StackPanel>

        <StackPanel Margin="{StaticResource AriaSpace1}">
            <TextBlock Text="Keep running in the notification area" Style="{StaticResource AriaBodyTextStyle}" Margin="{StaticResource AriaSpace1}" />
            <TextBlock Text="Closing the window keeps downloads going." Style="{StaticResource AriaMetadataTextStyle}" TextWrapping="Wrap" Margin="{StaticResource AriaSpace1}" />
            <ToggleSwitch OffContent="Off" OnContent="On" IsEnabled="False"
                          ToolTipService.ToolTip="The notification-area behavior is fixed in this build."
                          AutomationProperties.Name="Keep running in notification area" Margin="{StaticResource AriaSpace1}" />
        </StackPanel>

        <StackPanel Margin="{StaticResource AriaSpace1}">
            <TextBlock Text="Default save folder" Style="{StaticResource AriaBodyTextStyle}" Margin="{StaticResource AriaSpace1}" />
            <TextBlock Text="Used for new downloads unless a different folder is chosen." Style="{StaticResource AriaMetadataTextStyle}"
                       TextWrapping="Wrap" Margin="{StaticResource AriaSpace1}" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding DefaultFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Default save folder" Margin="{StaticResource AriaSpace1}" />
                <Button Grid.Column="1" Content="Browse…" IsEnabled="False" ToolTipService.ToolTip="Browsing for a folder is not available in this build."
                        AutomationProperties.Name="Browse for default save folder" Style="{StaticResource AriaSecondaryButtonStyle}" Margin="{StaticResource AriaSpace1}" />
            </Grid>
            <TextBlock Text="{Binding FolderStatus}" Style="{StaticResource AriaMetadataTextStyle}" TextWrapping="Wrap"
                       Margin="{StaticResource AriaSpace1}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <HyperlinkButton Content="Reset this section to defaults" Click="ResetClick" HorizontalAlignment="Left" Margin="{StaticResource AriaSpace1}" />
    </StackPanel>
</UserControl>
