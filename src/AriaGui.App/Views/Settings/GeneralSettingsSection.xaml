<UserControl x:Class="AriaGui.App.Views.Settings.GeneralSettingsSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16">
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Launch at sign-in" /><TextBlock Text="Start AriaGUI when you sign in to Windows." Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" /></StackPanel><ToggleSwitch Grid.Column="1" OffContent="Off" OnContent="On" IsEnabled="False" ToolTipService.ToolTip="Not available yet" AutomationProperties.Name="Launch at sign-in" /></Grid>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Keep running in the notification area" /><TextBlock Text="Closing the window keeps downloads going." Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" /></StackPanel><ToggleSwitch Grid.Column="1" OffContent="Off" OnContent="On" IsEnabled="False" ToolTipService.ToolTip="Not available yet" AutomationProperties.Name="Keep running in notification area" /></Grid>
        <StackPanel Spacing="8"><TextBlock Text="Default save folder" /><TextBlock Text="Used for new downloads unless a different folder is chosen." Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" /><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding DefaultFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Default save folder" /><Button Grid.Column="1" Content="Browse…" IsEnabled="False" ToolTipService.ToolTip="Not available yet" Style="{StaticResource AriaSecondaryButtonStyle}" /></Grid><TextBlock Text="{Binding FolderStatus}" FontSize="{StaticResource AriaMinimumFontSize}" Foreground="{ThemeResource AriaTextSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
        <HyperlinkButton Content="Reset this section to defaults" Click="ResetClick" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
