<UserControl x:Class="AriaGui.App.Views.Settings.DownloadsSettingsSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16">
        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="Download limits are managed from the Downloads toolbar in this version." />
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Concurrent downloads" /><TextBlock Text="Maximum transfers that can run at once." Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" /></StackPanel><NumberBox Grid.Column="1" Minimum="1" Maximum="64" IsEnabled="False" ToolTipService.ToolTip="Not available yet" AutomationProperties.Name="Concurrent downloads" /></Grid>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Retry failed downloads" /><TextBlock Text="Retry transient network failures automatically." Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" /></StackPanel><ToggleSwitch Grid.Column="1" IsEnabled="False" ToolTipService.ToolTip="Not available yet" OffContent="Off" OnContent="On" /></Grid>
        <HyperlinkButton Content="Reset this section to defaults" IsEnabled="False" ToolTipService.ToolTip="No saved settings in this section yet" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
