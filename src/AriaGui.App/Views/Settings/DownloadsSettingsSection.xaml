<UserControl x:Class="AriaGui.App.Views.Settings.DownloadsSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="{StaticResource AriaSpace1}"
                 Message="Concurrent download limit configuration is unavailable in this build." />

        <StackPanel Margin="{StaticResource AriaSpace1}">
            <TextBlock Text="Concurrent downloads" Style="{StaticResource AriaBodyTextStyle}" Margin="{StaticResource AriaSpace1}" />
            <TextBlock Text="Maximum transfers that can run at once." Style="{StaticResource AriaMetadataTextStyle}" TextWrapping="Wrap" Margin="{StaticResource AriaSpace1}" />
            <NumberBox Minimum="1" Maximum="64" IsEnabled="False"
                       ToolTipService.ToolTip="Concurrent download limit configuration is unavailable in this build."
                       AutomationProperties.Name="Concurrent downloads" Margin="{StaticResource AriaSpace1}" HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Margin="{StaticResource AriaSpace1}">
            <TextBlock Text="Retry failed downloads" Style="{StaticResource AriaBodyTextStyle}" Margin="{StaticResource AriaSpace1}" />
            <TextBlock Text="Retry transient network failures automatically." Style="{StaticResource AriaMetadataTextStyle}" TextWrapping="Wrap" Margin="{StaticResource AriaSpace1}" />
            <ToggleSwitch IsEnabled="False" ToolTipService.ToolTip="Automatic retries are not available in this version."
                          OffContent="Off" OnContent="On" AutomationProperties.Name="Retry failed downloads"
                          Margin="{StaticResource AriaSpace1}" />
        </StackPanel>

        <HyperlinkButton Content="Reset this section to defaults" IsEnabled="False" ToolTipService.ToolTip="No saved settings exist in this section yet."
                         HorizontalAlignment="Left" Margin="{StaticResource AriaSpace1}" />
    </StackPanel>
</UserControl>
