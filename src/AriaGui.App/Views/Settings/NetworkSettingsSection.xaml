<UserControl x:Class="AriaGui.App.Views.Settings.NetworkSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="{StaticResource AriaSpace1}"
                 Message="Proxy and connection-timeout settings are not available in this build." />
        <TextBox Header="Proxy" IsEnabled="False" ToolTipService.ToolTip="Proxy settings are not supported in this build."
                 AutomationProperties.Name="Proxy" Margin="{StaticResource AriaSpace1}" HorizontalAlignment="Stretch" />
        <NumberBox Header="Connection timeout (seconds)" IsEnabled="False"
                   ToolTipService.ToolTip="Connection timeout settings are not supported in this build."
                   AutomationProperties.Name="Connection timeout" Margin="{StaticResource AriaSpace1}" HorizontalAlignment="Stretch" />
        <HyperlinkButton Content="Reset this section to defaults" IsEnabled="False" ToolTipService.ToolTip="No saved settings exist in this section yet."
                         HorizontalAlignment="Left" Margin="{StaticResource AriaSpace1}" />
    </StackPanel>
</UserControl>
