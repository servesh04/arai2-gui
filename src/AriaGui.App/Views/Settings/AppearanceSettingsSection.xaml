<UserControl x:Class="AriaGui.App.Views.Settings.AppearanceSettingsSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16">
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Theme" /><TextBlock Text="Follow Windows or choose a light or dark appearance." Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" /></StackPanel><ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" AutomationProperties.Name="App theme"><x:String>System</x:String><x:String>Light</x:String><x:String>Dark</x:String></ComboBox></Grid>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Compact density" /><TextBlock Text="Show more transfers by reducing row height." Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" /></StackPanel><ToggleSwitch Grid.Column="1" IsOn="{Binding CompactRows, Mode=TwoWay}" OffContent="Comfortable" OnContent="Compact" AutomationProperties.Name="Compact transfer rows" /></Grid>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Language" /><TextBlock Text="Choose the app display language." Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" /></StackPanel><ComboBox Grid.Column="1" IsEnabled="False" ToolTipService.ToolTip="Not available yet" AutomationProperties.Name="App language"><x:String>System default</x:String></ComboBox></Grid>
        <HyperlinkButton Content="Reset this section to defaults" Click="ResetClick" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
