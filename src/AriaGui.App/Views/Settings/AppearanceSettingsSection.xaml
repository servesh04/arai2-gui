<UserControl x:Class="AriaGui.App.Views.Settings.AppearanceSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Margin="{StaticResource AriaSpace1}">
            <TextBlock Text="Theme" Style="{StaticResource AriaBodyTextStyle}" Margin="{StaticResource AriaSpace1}" />
            <TextBlock Text="Follow Windows or choose a light or dark appearance." Style="{StaticResource AriaMetadataTextStyle}" TextWrapping="Wrap" Margin="{StaticResource AriaSpace1}" />
            <ComboBox SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" AutomationProperties.Name="App theme"
                      Margin="{StaticResource AriaSpace1}" HorizontalAlignment="Stretch">
                <x:String>System</x:String><x:String>Light</x:String><x:String>Dark</x:String>
            </ComboBox>
        </StackPanel>

        <StackPanel Margin="{StaticResource AriaSpace1}">
            <TextBlock Text="Compact density" Style="{StaticResource AriaBodyTextStyle}" Margin="{StaticResource AriaSpace1}" />
            <TextBlock Text="Show more transfers by reducing row height." Style="{StaticResource AriaMetadataTextStyle}" TextWrapping="Wrap" Margin="{StaticResource AriaSpace1}" />
            <ToggleSwitch IsOn="{Binding CompactRows, Mode=TwoWay}" OffContent="Comfortable" OnContent="Compact"
                          AutomationProperties.Name="Compact transfer rows" Margin="{StaticResource AriaSpace1}" />
        </StackPanel>

        <StackPanel Margin="{StaticResource AriaSpace1}">
            <TextBlock Text="Language" Style="{StaticResource AriaBodyTextStyle}" Margin="{StaticResource AriaSpace1}" />
            <TextBlock Text="Choose the app display language." Style="{StaticResource AriaMetadataTextStyle}" TextWrapping="Wrap" Margin="{StaticResource AriaSpace1}" />
            <ComboBox IsEnabled="False" ToolTipService.ToolTip="Language selection is not supported in this build."
                      AutomationProperties.Name="App language" Margin="{StaticResource AriaSpace1}" HorizontalAlignment="Stretch">
                <x:String>System default</x:String>
            </ComboBox>
        </StackPanel>

        <HyperlinkButton Content="Reset this section to defaults" Click="ResetClick" HorizontalAlignment="Left" Margin="{StaticResource AriaSpace1}" />
    </StackPanel>
</UserControl>
