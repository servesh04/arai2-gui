<UserControl x:Class="AriaGui.App.Views.Downloads.DownloadsTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AriaGui.App.Views.Downloads"
    xmlns:vm="using:AriaGui.App.ViewModels">
    <UserControl.Resources>
        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="AriaListViewItemCheckBoxBorderBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="AriaListViewItemCheckBoxBorderBrush" />
        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" ResourceKey="AriaListViewItemCheckBoxBorderBrush" />
        <local:DownloadFileGlyphConverter x:Key="FileGlyph" />
        <local:DownloadRowVisibilityConverter x:Key="RowVisibility" />
        <local:DownloadStatusLabelConverter x:Key="StatusLabel" />
        <local:DownloadStatusGlyphConverter x:Key="StatusGlyph" />
        <local:DownloadProgressTextConverter x:Key="ProgressText" />
        <local:DownloadProgressBrushConverter x:Key="ProgressBrush" />
        <local:DownloadDateLabelConverter x:Key="DateLabel" />
        <local:DownloadDateTooltipConverter x:Key="DateTooltip" />
        <local:TorrentKindVisibilityConverter x:Key="TorrentKindVisibility" />
        <local:NonemptyTextVisibilityConverter x:Key="NonemptyTextVisibility" />
        <local:TorrentMetricTextConverter x:Key="TorrentMetricText" />
        <local:CurrentStatusVisibilityConverter x:Key="CurrentStatusVisibility" />
        <local:CurrentStatusLabelConverter x:Key="CurrentStatusLabel" />
        <local:CurrentStatusGlyphConverter x:Key="CurrentStatusGlyph" />
        <local:BooleanVisibilityConverter x:Key="BooleanVisibility" />
        <Style x:Key="TableHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource AriaToolbarButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource AriaSurfaceBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AriaTextMetadataBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AriaSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource AriaStandardBorderThickness}" />
            <Setter Property="FontSize" Value="{StaticResource AriaFontSizeMetadata}" />
        </Style>
        <Style x:Key="MeasuredFilenameTextStyle" TargetType="local:MeasuredMiddleEllipsisTextBlock">
            <Setter Property="FontSize" Value="{StaticResource AriaFontSizePrimary}" />
            <Setter Property="Foreground" Value="{ThemeResource AriaTextFilenameBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource AriaFontSizeMetadata}" />
            <Setter Property="Foreground" Value="{ThemeResource AriaTextMetadataBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="{StaticResource AriaSpace2}" />
        </Style>
        <Style x:Key="NumericCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource AriaToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="{StaticResource AriaControlTargetSize}" />
            <Setter Property="MinHeight" Value="{StaticResource AriaControlTargetSize}" />
        </Style>
        <DataTemplate x:Key="ProgressCellTemplate" x:DataType="vm:DownloadItemViewModel">
            <Grid Margin="{StaticResource AriaRowPadding}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"
                  Visibility="{Binding RawStatus, Converter={StaticResource CurrentStatusVisibility}, ConverterParameter=Progress}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Path=., Converter={StaticResource ProgressText}}" Style="{StaticResource AriaMetadataTextStyle}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                    <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" Style="{StaticResource AriaMetadataTextStyle}" HorizontalAlignment="Right" TextAlignment="Right" Typography.NumeralAlignment="Tabular" />
                </Grid>
                <ProgressBar Grid.Row="1" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="{StaticResource AriaProgressThickness}" Foreground="{Binding Path=., Converter={StaticResource ProgressBrush}}" CornerRadius="{StaticResource AriaControlCornerRadius}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StatusCellTemplate" x:DataType="vm:DownloadItemViewModel">
            <Grid Margin="{StaticResource AriaRowPadding}" VerticalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Visibility="{Binding RawStatus, Converter={StaticResource CurrentStatusVisibility}, ConverterParameter=Plain}" AutomationProperties.AccessibilityView="Raw">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding RawStatus, Converter={StaticResource CurrentStatusGlyph}}" FontSize="{StaticResource AriaIconSizeSmall}" Margin="{StaticResource AriaSpace1}" />
                    <TextBlock Text="{Binding RawStatus, Converter={StaticResource CurrentStatusLabel}}" Style="{StaticResource AriaMetadataTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource AriaStatusPillStyle}" HorizontalAlignment="Left" Visibility="{Binding RawStatus, Converter={StaticResource CurrentStatusVisibility}, ConverterParameter=Pill}" AutomationProperties.AccessibilityView="Raw">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding RawStatus, Converter={StaticResource CurrentStatusGlyph}}" FontSize="{StaticResource AriaIconSizeSmall}" Margin="{StaticResource AriaSpace1}" />
                        <TextBlock Text="{Binding RawStatus, Converter={StaticResource CurrentStatusLabel}}" Style="{StaticResource AriaMetadataTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Visibility="{Binding RawStatus, Converter={StaticResource CurrentStatusVisibility}, ConverterParameter=Failed}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="{StaticResource AriaIconSizeSmall}" Margin="{StaticResource AriaSpace1}" Foreground="{ThemeResource AriaDangerBrush}" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="Failed" Style="{StaticResource AriaMetadataTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Command="{Binding RetryCommand}" Style="{StaticResource AriaToolbarButtonStyle}"
                                ToolTipService.ToolTip="Retry failed download" AutomationProperties.Name="Retry failed download">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="{StaticResource AriaIconSizeSmall}" AutomationProperties.AccessibilityView="Raw" />
                        </Button>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding SubstateText}" Grid.Row="1" Style="{StaticResource AriaMetadataTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SubstateText}" Visibility="{Binding SubstateText, Converter={StaticResource NonemptyTextVisibility}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer x:Name="TableScroller" SizeChanged="TableViewportChanged" ViewChanged="TableViewportViewChanged"
                  HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                  VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid x:Name="TableCanvas" HorizontalAlignment="Left">
            <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid x:Name="TableHeader" Background="{ThemeResource AriaSurfaceBrush}" />
            <ListView x:Name="TransferList" Grid.Row="1" Padding="0" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="False"
                      ItemsSource="{Binding ViewModel.Downloads}" SelectionChanged="TransferSelectionChanged"
                      KeyDown="TransferListKeyDown" AutomationProperties.Name="Transfers"
                      ContainerContentChanging="DownloadContainerChanging"
                      ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.Resources>
                    <StaticResource x:Key="ListViewItemCheckBoxBrush" ResourceKey="AriaListViewItemCheckBoxBrush" />
                    <StaticResource x:Key="ListViewItemCheckBoxDisabledBrush" ResourceKey="AriaListViewItemCheckBoxDisabledBrush" />
                    <StaticResource x:Key="ListViewItemCheckBoxBorderBrush" ResourceKey="AriaListViewItemCheckBoxBorderBrush" />
                    <StaticResource x:Key="ListViewItemCheckBoxDisabledBorderBrush" ResourceKey="AriaListViewItemCheckBoxDisabledBorderBrush" />
                    <StaticResource x:Key="ListViewItemCheckBoxSelectedBrush" ResourceKey="AriaListViewItemCheckBoxSelectedBrush" />
                    <StaticResource x:Key="ListViewItemCheckBoxSelectedDisabledBrush" ResourceKey="AriaListViewItemCheckBoxSelectedDisabledBrush" />
                    <StaticResource x:Key="ListViewItemCheckBrush" ResourceKey="AriaListViewItemCheckBrush" />
                    <StaticResource x:Key="ListViewItemCheckDisabledBrush" ResourceKey="AriaListViewItemCheckDisabledBrush" />
                </ListView.Resources>
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" CacheLength="1" /></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="{StaticResource AriaRowHeightCompact}" />
                        <Setter Property="CornerRadius" Value="{StaticResource AriaControlCornerRadius}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadItemViewModel">
                        <Grid Tag="TransferRow" Loaded="TransferRowLoaded" PointerEntered="TransferRowPointerEntered" PointerExited="TransferRowPointerExited">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <CheckBox Tag="TransferSelectionCheck" Width="{StaticResource AriaControlTargetSize}" MinWidth="{StaticResource AriaControlTargetSize}" Height="{StaticResource AriaControlTargetSize}"
                                      VerticalAlignment="Center" Loaded="RowCheckLoaded" Click="RowCheckClick" Tapped="RowCheckTapped"
                                      ToolTipService.ToolTip="Select transfer" AutomationProperties.Name="{Binding FileName}" />
                            <Grid x:Name="WideRow" Grid.Column="1" Tag="TransferDataGrid" Loaded="RowLoaded" HorizontalAlignment="Left">
                                <Grid Tag="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <FontIcon Grid.RowSpan="2" FontFamily="Segoe Fluent Icons" Glyph="{Binding FileName, Converter={StaticResource FileGlyph}}" FontSize="{StaticResource AriaIconSizeSmall}" Margin="{StaticResource AriaRowPadding}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                    <Grid Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="BT" Style="{StaticResource AriaMetadataTextStyle}" Margin="{StaticResource AriaSpace1}" ToolTipService.ToolTip="BitTorrent transfer" Visibility="{Binding Kind, Converter={StaticResource TorrentKindVisibility}}" AutomationProperties.Name="BitTorrent transfer" />
                                        <local:MeasuredMiddleEllipsisTextBlock Grid.Column="1" FullText="{Binding FileName}" Style="{StaticResource MeasuredFilenameTextStyle}" VerticalAlignment="Center" Margin="{StaticResource AriaSpace1}" ToolTipService.ToolTip="{Binding FileName}" AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding FailureReason}" Style="{StaticResource AriaMetadataTextStyle}"
                                               Foreground="{ThemeResource AriaDangerBrush}" TextTrimming="CharacterEllipsis" Margin="{StaticResource AriaSpace1}"
                                               ToolTipService.ToolTip="{Binding FailureReason}" AutomationProperties.Name="{Binding FailureReason}"
                                               Visibility="{Binding FailureReason, Converter={StaticResource NonemptyTextVisibility}}" />
                                    <StackPanel Tag="HoverActions" Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" Margin="{StaticResource AriaSpace1}" Visibility="Collapsed" Background="{ThemeResource AriaSurfaceBrush}" VerticalAlignment="Center">
                                        <Button Style="{StaticResource RowIconButton}" Command="{Binding RetryCommand}" Visibility="{Binding ShowRetry, Converter={StaticResource BooleanVisibility}}" ToolTipService.ToolTip="Retry" AutomationProperties.Name="Retry download"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="{StaticResource AriaIconSizeSmall}" /></Button>
                                        <Button Style="{StaticResource RowIconButton}" Command="{Binding PauseCommand}" Visibility="{Binding ShowPause, Converter={StaticResource BooleanVisibility}}" ToolTipService.ToolTip="Pause" AutomationProperties.Name="Pause download"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE769;" FontSize="{StaticResource AriaIconSizeSmall}" /></Button>
                                        <Button Style="{StaticResource RowIconButton}" Command="{Binding ResumeCommand}" Visibility="{Binding ShowResume, Converter={StaticResource BooleanVisibility}}" ToolTipService.ToolTip="Resume" AutomationProperties.Name="Resume download"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="{StaticResource AriaIconSizeSmall}" /></Button>
                                        <Button Style="{StaticResource RowIconButton}" Command="{Binding OpenFolderCommand}" ToolTipService.ToolTip="Open folder" AutomationProperties.Name="Open download folder"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE838;" FontSize="{StaticResource AriaIconSizeSmall}" /></Button>
                                        <Button Style="{StaticResource RowIconButton}" Click="RowOverflowClick" ToolTipService.ToolTip="More actions" AutomationProperties.Name="More download actions"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" FontSize="{StaticResource AriaIconSizeSmall}" /></Button>
                                    </StackPanel>
                                </Grid>
                                <ContentControl Tag="3" Content="{Binding Path=.}" ContentTemplate="{StaticResource ProgressCellTemplate}" />
                                <ContentControl Tag="4" Content="{Binding Path=.}" ContentTemplate="{StaticResource StatusCellTemplate}" />
                                <TextBlock Tag="5" Text="{Binding SpeedLabel}" Style="{StaticResource NumericCellText}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Tag="6" Text="{Binding EtaLabel}" Style="{StaticResource NumericCellText}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Tag="100" Text="{Binding Entry.Job.CreatedAt, Converter={StaticResource DateLabel}}" ToolTipService.ToolTip="{Binding Entry.Job.CreatedAt, Converter={StaticResource DateTooltip}}" Style="{StaticResource CellText}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Tag="2" Text="{Binding TotalSizeLabel}" Style="{StaticResource NumericCellText}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Tag="101" Text="{Binding Peers, Converter={StaticResource TorrentMetricText}}" Style="{StaticResource NumericCellText}" />
                                <TextBlock Tag="102" Text="{Binding Seeds, Converter={StaticResource TorrentMetricText}}" Style="{StaticResource NumericCellText}" />
                                <TextBlock Tag="103" Text="{Binding UploadBytesPerSecond, Converter={StaticResource TorrentMetricText}, ConverterParameter=Rate}" Style="{StaticResource NumericCellText}" />
                                <TextBlock Tag="104" Text="{Binding Ratio, Converter={StaticResource TorrentMetricText}, ConverterParameter=Ratio}" Style="{StaticResource NumericCellText}" />
                            </Grid>
                            <Grid x:Name="NarrowRow" Grid.Column="1" Tag="NarrowRow" Visibility="Collapsed" Padding="{StaticResource AriaRowPadding}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding FileName, Converter={StaticResource FileGlyph}}" FontSize="{StaticResource AriaIconSizeSmall}" Margin="{StaticResource AriaSpace1}" AutomationProperties.AccessibilityView="Raw" />
                                        <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="BT" Style="{StaticResource AriaMetadataTextStyle}" Margin="{StaticResource AriaSpace1}" ToolTipService.ToolTip="BitTorrent transfer" Visibility="{Binding Kind, Converter={StaticResource TorrentKindVisibility}}" AutomationProperties.Name="BitTorrent transfer" />
                                        <local:MeasuredMiddleEllipsisTextBlock Grid.Column="1" FullText="{Binding FileName}" Style="{StaticResource MeasuredFilenameTextStyle}" ToolTipService.ToolTip="{Binding FileName}" AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                        <Button Grid.Column="2" Style="{StaticResource RowIconButton}" Click="RowOverflowClick" ToolTipService.ToolTip="More actions" AutomationProperties.Name="More download actions"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" FontSize="{StaticResource AriaIconSizeSmall}" /></Button>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="{StaticResource AriaProgressThickness}" Foreground="{Binding Path=., Converter={StaticResource ProgressBrush}}" CornerRadius="{StaticResource AriaControlCornerRadius}" VerticalAlignment="Center" Visibility="{Binding RawStatus, Converter={StaticResource CurrentStatusVisibility}, ConverterParameter=Progress}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" Style="{StaticResource AriaMetadataTextStyle}" Margin="{StaticResource AriaSpace1}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Visibility="{Binding RawStatus, Converter={StaticResource CurrentStatusVisibility}, ConverterParameter=Progress}" AutomationProperties.AccessibilityView="Raw" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding RawStatus, Converter={StaticResource CurrentStatusGlyph}}" FontSize="{StaticResource AriaIconSizeSmall}" Margin="{StaticResource AriaSpace1}" />
                                        <TextBlock Text="{Binding RawStatus, Converter={StaticResource CurrentStatusLabel}}" Style="{StaticResource AriaMetadataTextStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Speed:" Style="{StaticResource AriaMetadataTextStyle}" Margin="{StaticResource AriaSpace1}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SpeedLabel}" Style="{StaticResource AriaMetadataTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SpeedLabel}" />
                                    </Grid>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="ETA:" Style="{StaticResource AriaMetadataTextStyle}" Margin="{StaticResource AriaSpace1}" />
                                        <TextBlock Grid.Column="1" Text="{Binding EtaLabel}" Style="{StaticResource AriaMetadataTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding EtaLabel}" />
                                    </Grid>
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Size:" Style="{StaticResource AriaMetadataTextStyle}" Margin="{StaticResource AriaSpace1}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TotalSizeLabel}" Style="{StaticResource AriaMetadataTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding TotalSizeLabel}" />
                                    </Grid>
                                </Grid>
                                <StackPanel Grid.Row="3">
                                    <TextBlock Text="{Binding SubstateText}" Style="{StaticResource AriaMetadataTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SubstateText}" Visibility="{Binding SubstateText, Converter={StaticResource NonemptyTextVisibility}}" />
                                    <TextBlock Text="{Binding FailureReason}" Foreground="{ThemeResource AriaDangerBrush}" Style="{StaticResource AriaMetadataTextStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FailureReason}" Visibility="{Binding FailureReason, Converter={StaticResource NonemptyTextVisibility}}" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.ColumnSpan="2" Style="{StaticResource AriaQuietDividerStyle}" VerticalAlignment="Bottom" IsHitTestVisible="False" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </ScrollViewer>
</UserControl>
