<UserControl x:Class="AriaGui.App.Views.Downloads.DownloadsTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AriaGui.App.Views.Downloads"
    xmlns:vm="using:AriaGui.App.ViewModels">
    <UserControl.Resources>
        <local:DownloadFileGlyphConverter x:Key="FileGlyph" />
        <local:DownloadRowVisibilityConverter x:Key="RowVisibility" />
        <local:DownloadStatusLabelConverter x:Key="StatusLabel" />
        <local:DownloadStatusGlyphConverter x:Key="StatusGlyph" />
        <local:DownloadProgressTextConverter x:Key="ProgressText" />
        <local:DownloadProgressBrushConverter x:Key="ProgressBrush" />
        <local:DownloadDateLabelConverter x:Key="DateLabel" />
        <local:DownloadDateTooltipConverter x:Key="DateTooltip" />
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource AriaMinimumFontSize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="{StaticResource AriaSpace2}" />
        </Style>
        <Style x:Key="NumericCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource AriaToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <DataTemplate x:Key="ProgressCellTemplate" x:DataType="vm:DownloadItemViewModel">
            <Grid Margin="8,4" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="5" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Converter={StaticResource ProgressText}}" FontSize="{StaticResource AriaMinimumFontSize}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                    <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" FontSize="{StaticResource AriaMinimumFontSize}" HorizontalAlignment="Right" TextAlignment="Right" Typography.NumeralAlignment="Tabular" />
                </Grid>
                <ProgressBar Grid.Row="1" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="5" Foreground="{Binding Converter={StaticResource ProgressBrush}}" CornerRadius="3" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StatusCellTemplate" x:DataType="vm:DownloadItemViewModel">
            <Grid Margin="8,3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{Binding Converter={StaticResource RowVisibility}, ConverterParameter=Plain}" AutomationProperties.AccessibilityView="Raw">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding Converter={StaticResource StatusGlyph}}" FontSize="12" />
                    <TextBlock Text="{Binding Converter={StaticResource StatusLabel}}" FontSize="{StaticResource AriaMinimumFontSize}" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource AriaStatusPillStyle}" HorizontalAlignment="Left" Visibility="{Binding Converter={StaticResource RowVisibility}, ConverterParameter=Pill}" AutomationProperties.AccessibilityView="Raw">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding Converter={StaticResource StatusGlyph}}" FontSize="12" />
                        <TextBlock Text="{Binding Converter={StaticResource StatusLabel}}" FontSize="{StaticResource AriaMinimumFontSize}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Visibility="{Binding Converter={StaticResource RowVisibility}, ConverterParameter=Failed}" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource AriaDangerBrush}" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="Failed" FontSize="{StaticResource AriaMinimumFontSize}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="Retry" Command="{Binding RetryCommand}" Style="{StaticResource AriaSecondaryButtonStyle}" MinHeight="26" Padding="8,2" AutomationProperties.Name="Retry failed download" />
                    </StackPanel>
                    <TextBlock Text="{Binding FailureReason}" Foreground="{ThemeResource AriaDangerBrush}" FontSize="{StaticResource AriaMinimumFontSize}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FailureReason}" Visibility="{Binding Converter={StaticResource RowVisibility}, ConverterParameter=FailedReason}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer x:Name="TableScroller" SizeChanged="TableViewportChanged" ViewChanged="TableViewportViewChanged"
                  HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                  VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid x:Name="TableCanvas" HorizontalAlignment="Left">
            <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid x:Name="TableHeader" Background="{ThemeResource AriaSurfaceRaisedBrush}" BorderBrush="{ThemeResource AriaBorderBrush}" BorderThickness="0,1,0,1" />
            <ListView x:Name="TransferList" Grid.Row="1" Padding="0" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True"
                      ItemsSource="{Binding ViewModel.Downloads}" SelectionChanged="TransferSelectionChanged"
                      KeyDown="TransferListKeyDown" AutomationProperties.Name="Transfers"
                      ContainerContentChanging="DownloadContainerChanging"
                      ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.Resources>
                    <StaticResource x:Key="ListViewItemCheckBoxBrush" ResourceKey="AriaListViewItemCheckBoxBrush" />
                    <StaticResource x:Key="ListViewItemCheckBoxDisabledBrush" ResourceKey="AriaListViewItemCheckBoxDisabledBrush" />
                    <StaticResource x:Key="ListViewItemCheckBoxBorderBrush" ResourceKey="AriaListViewItemCheckBoxBorderBrush" />
                    <StaticResource x:Key="ListViewItemCheckBoxDisabledBorderBrush" ResourceKey="AriaListViewItemCheckBoxDisabledBorderBrush" />
                    <StaticResource x:Key="ListViewItemCheckBoxSelectedBrush" ResourceKey="AriaListViewItemCheckBoxSelectedBrush" />
                    <StaticResource x:Key="ListViewItemCheckBoxSelectedDisabledBrush" ResourceKey="AriaListViewItemCheckBoxSelectedDisabledBrush" />
                    <StaticResource x:Key="ListViewItemCheckBrush" ResourceKey="AriaListViewItemCheckBrush" />
                    <StaticResource x:Key="ListViewItemCheckDisabledBrush" ResourceKey="AriaListViewItemCheckDisabledBrush" />
                </ListView.Resources>
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" CacheLength="1" /></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="{StaticResource AriaRowHeightCompact}" />
                        <Setter Property="CornerRadius" Value="{StaticResource AriaControlCornerRadius}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadItemViewModel">
                        <Grid Tag="TransferRow" Loaded="TransferRowLoaded" PointerEntered="TransferRowPointerEntered" PointerExited="TransferRowPointerExited"
                              BorderBrush="{ThemeResource AriaBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid x:Name="WideRow" Tag="TransferDataGrid" Loaded="RowLoaded" HorizontalAlignment="Left">
                                <Grid Tag="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding FileName, Converter={StaticResource FileGlyph}}" FontSize="16" Margin="8,0,2,0" AutomationProperties.AccessibilityView="Raw" />
                                    <local:MeasuredMiddleEllipsisTextBlock Grid.Column="1" FullText="{Binding FileName}" FontSize="{StaticResource AriaMinimumFontSize}" VerticalAlignment="Center" Margin="6,0" ToolTipService.ToolTip="{Binding FileName}" AutomationProperties.AccessibilityView="Raw" />
                                    <StackPanel Tag="HoverActions" Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="2" Visibility="Collapsed" Background="{ThemeResource AriaSurfaceBrush}">
                                        <Button Style="{StaticResource RowIconButton}" Command="{Binding RetryCommand}" Visibility="{Binding Converter={StaticResource RowVisibility}, ConverterParameter=Retry}" ToolTipService.ToolTip="Retry" AutomationProperties.Name="Retry download"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="12" /></Button>
                                        <Button Style="{StaticResource RowIconButton}" Command="{Binding PauseCommand}" Visibility="{Binding Converter={StaticResource RowVisibility}, ConverterParameter=Pause}" ToolTipService.ToolTip="Pause" AutomationProperties.Name="Pause download"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE769;" FontSize="12" /></Button>
                                        <Button Style="{StaticResource RowIconButton}" Command="{Binding ResumeCommand}" Visibility="{Binding Converter={StaticResource RowVisibility}, ConverterParameter=Resume}" ToolTipService.ToolTip="Resume" AutomationProperties.Name="Resume download"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="12" /></Button>
                                        <Button Style="{StaticResource RowIconButton}" Command="{Binding OpenFolderCommand}" ToolTipService.ToolTip="Open folder" AutomationProperties.Name="Open download folder"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE838;" FontSize="12" /></Button>
                                        <Button Style="{StaticResource RowIconButton}" Click="RowOverflowClick" ToolTipService.ToolTip="More actions" AutomationProperties.Name="More download actions"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" FontSize="12" /></Button>
                                    </StackPanel>
                                </Grid>
                                <ContentControl Tag="3" Content="{Binding}" ContentTemplate="{StaticResource ProgressCellTemplate}" />
                                <ContentControl Tag="4" Content="{Binding}" ContentTemplate="{StaticResource StatusCellTemplate}" />
                                <TextBlock Tag="5" Text="{Binding SpeedLabel}" Style="{StaticResource NumericCellText}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Tag="6" Text="{Binding EtaLabel}" Style="{StaticResource NumericCellText}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Tag="100" Text="{Binding Entry.Job.CreatedAt, Converter={StaticResource DateLabel}}" ToolTipService.ToolTip="{Binding Entry.Job.CreatedAt, Converter={StaticResource DateTooltip}}" Style="{StaticResource CellText}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Tag="2" Text="{Binding TotalSizeLabel}" Style="{StaticResource NumericCellText}" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                            <Grid x:Name="NarrowRow" Tag="NarrowRow" Visibility="Collapsed" Padding="8,5" RowSpacing="5">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding FileName, Converter={StaticResource FileGlyph}}" FontSize="16" Margin="0,0,6,0" AutomationProperties.AccessibilityView="Raw" />
                                    <local:MeasuredMiddleEllipsisTextBlock Grid.Column="1" FullText="{Binding FileName}" FontSize="{StaticResource AriaMinimumFontSize}" ToolTipService.ToolTip="{Binding FileName}" AutomationProperties.AccessibilityView="Raw" />
                                    <Button Grid.Column="2" Style="{StaticResource RowIconButton}" Click="RowOverflowClick" ToolTipService.ToolTip="More actions" AutomationProperties.Name="More download actions"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" FontSize="12" /></Button>
                                </Grid>
                                <Grid Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="5" Foreground="{Binding Converter={StaticResource ProgressBrush}}" CornerRadius="3" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" FontSize="{StaticResource AriaMinimumFontSize}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding Converter={StaticResource StatusGlyph}}" FontSize="12" />
                                        <TextBlock Text="{Binding Converter={StaticResource StatusLabel}}" FontSize="{StaticResource AriaMinimumFontSize}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="2" Text="{Binding FailureReason}" Foreground="{ThemeResource AriaDangerBrush}" FontSize="{StaticResource AriaMinimumFontSize}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FailureReason}" Visibility="{Binding Converter={StaticResource RowVisibility}, ConverterParameter=FailedReason}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </ScrollViewer>
</UserControl>
