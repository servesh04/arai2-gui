<UserControl x:Class="AriaGui.App.Views.Downloads.FiltersRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:AriaGui.App.Icons">
    <Grid Background="{ThemeResource AriaBackgroundBrush}" Padding="{StaticResource AriaSpace2}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Spacing="{StaticResource AriaRadiusOuter}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusOuter}" Margin="{StaticResource AriaSpace2}">
                <icons:FluentIcon IconName="Download" FontSize="{StaticResource AriaMinimumFontSize}" Foreground="{ThemeResource AriaAccentBrush}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="AriaGUI" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="DownloadsButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="DownloadsClick" AutomationProperties.Name="Downloads">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusOuter}"><icons:FluentIcon IconName="Download" /><TextBlock Text="Downloads" /></StackPanel>
            </Button>
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource AriaRadiusOuter}">
                <StackPanel x:Name="TransferFilters" Spacing="{StaticResource AriaRadiusControl}" Margin="{StaticResource AriaSpace3}">
                    <TextBlock Text="TRANSFERS" FontWeight="SemiBold" Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" />
                    <ListView x:Name="StatusFilters" SelectedIndex="{Binding ViewModel.FilterIndex, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.Name="Download status filter">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="{StaticResource AriaRowHeightCompact}" />
                                <Setter Property="Padding" Value="{StaticResource AriaSpace2}" />
                                <Setter Property="FontSize" Value="{StaticResource AriaMinimumFontSize}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="{StaticResource AriaControlCornerRadius}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <Grid ColumnSpacing="{StaticResource AriaRadiusControl}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}"><icons:FluentIcon IconName="List" /><TextBlock Text="All" /></StackPanel><TextBlock Grid.Column="1" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource AriaRadiusControl}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" /><TextBlock Text="Downloading" /></StackPanel><TextBlock Grid.Column="1" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource AriaRadiusControl}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE823;" /><TextBlock Text="Waiting" /></StackPanel><TextBlock Grid.Column="1" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource AriaRadiusControl}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE769;" /><TextBlock Text="Paused" /></StackPanel><TextBlock Grid.Column="1" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource AriaRadiusControl}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7BA;" /><TextBlock Text="Interrupted" /></StackPanel><TextBlock Grid.Column="1" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource AriaRadiusControl}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" /><TextBlock Text="Completed" /></StackPanel><TextBlock Grid.Column="1" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource AriaRadiusControl}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" /><TextBlock Text="Failed" /></StackPanel><TextBlock Grid.Column="1" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource AriaRadiusControl}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71A;" /><TextBlock Text="Stopped" /></StackPanel><TextBlock Grid.Column="1" HorizontalAlignment="Right" />
                        </Grid>
                    </ListView>
                </StackPanel>
                <Border Style="{StaticResource AriaDividerStyle}" Margin="{StaticResource AriaSpace2}" />
                <ToggleButton x:Name="HistoryButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="HistoryClick" AutomationProperties.Name="History">
                    <Grid ColumnSpacing="{StaticResource AriaRadiusControl}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}"><icons:FluentIcon IconName="History" /><TextBlock Text="History" /></StackPanel>
                        <TextBlock x:Name="HistoryCount" Grid.Column="1" />
                    </Grid>
                </ToggleButton>
                <Button IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Notifications are not available in this build." AutomationProperties.Name="Notifications, unavailable">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}"><icons:FluentIcon IconName="Notifications" /><TextBlock Text="Notifications" /></StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="SettingsClick" AutomationProperties.Name="Settings">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}"><icons:FluentIcon IconName="Settings" /><TextBlock Text="Settings" /></StackPanel>
        </Button>
    </Grid>
</UserControl>
