<UserControl x:Class="AriaGui.App.Views.Downloads.SelectionBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:AriaGui.App.Icons">
    <Grid Background="{ThemeResource AriaSelectionTintBrush}">
    <StackPanel x:Name="SelectedActions" Orientation="Horizontal" Padding="{StaticResource AriaSpace2}">
        <TextBlock x:Name="SelectedCountText" Text="0 selected" FontSize="{StaticResource AriaFontSizePrimary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="{StaticResource AriaSpace1}" />
        <Button x:Name="ResumeButton" Command="{Binding ViewModel.BatchResumeCommand}" Style="{StaticResource AriaToolbarButtonStyle}" Margin="{StaticResource AriaSpace1}" AutomationProperties.Name="Resume selected downloads">
            <StackPanel Orientation="Horizontal">
                <icons:FluentIcon IconName="Play" FontSize="{StaticResource AriaIconSizeSmall}" Margin="{StaticResource AriaSpace1}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="Resume" FontSize="{StaticResource AriaFontSizePrimary}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button x:Name="PauseButton" Command="{Binding ViewModel.BatchPauseCommand}" Style="{StaticResource AriaToolbarButtonStyle}" Margin="{StaticResource AriaSpace1}" AutomationProperties.Name="Pause selected downloads">
            <StackPanel Orientation="Horizontal">
                <icons:FluentIcon IconName="Pause" FontSize="{StaticResource AriaIconSizeSmall}" Margin="{StaticResource AriaSpace1}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="Pause" FontSize="{StaticResource AriaFontSizePrimary}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Button x:Name="RetryButton" Command="{Binding ViewModel.BatchRetryCommand}" Style="{StaticResource AriaToolbarButtonStyle}" Margin="{StaticResource AriaSpace1}" AutomationProperties.Name="Retry selected downloads">
            <StackPanel Orientation="Horizontal">
                <icons:FluentIcon IconName="Retry" FontSize="{StaticResource AriaIconSizeSmall}" Margin="{StaticResource AriaSpace1}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="Retry" FontSize="{StaticResource AriaFontSizePrimary}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <DropDownButton x:Name="MoreButton" Padding="{StaticResource AriaSecondaryButtonPadding}" MinHeight="{StaticResource AriaControlTargetSize}" Margin="{StaticResource AriaSpace1}" AutomationProperties.Name="More actions for selected downloads">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="More" FontSize="{StaticResource AriaFontSizePrimary}" VerticalAlignment="Center" />
            </StackPanel>
            <DropDownButton.Flyout>
                <MenuFlyout x:Name="MoreMenu">
                    <MenuFlyoutItem x:Name="OverflowRetry" Text="Retry" Command="{Binding ViewModel.BatchRetryCommand}" Visibility="Collapsed" />
                    <MenuFlyoutItem x:Name="RecoverItem" Text="Recover" Command="{Binding ViewModel.BatchRecoverCommand}" />
                    <MenuFlyoutItem x:Name="RestartFreshItem" Text="Restart fresh (keep partial files)" Command="{Binding ViewModel.BatchRestartFreshCommand}" />
                    <MenuFlyoutItem Text="Move earlier in queue" Click="SingleActionClick" Tag="MoveUp" />
                    <MenuFlyoutItem Text="Move later in queue" Click="SingleActionClick" Tag="MoveDown" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Open file" Click="SingleActionClick" Tag="OpenFile" />
                    <MenuFlyoutItem Text="Open folder" Click="SingleActionClick" Tag="OpenFolder" />
                    <MenuFlyoutItem x:Name="RemoveItem" Text="Remove from list" Command="{Binding ViewModel.BatchRemoveCommand}" />
                </MenuFlyout>
            </DropDownButton.Flyout>
        </DropDownButton>
        <Button x:Name="ClearButton" Content="Clear" Style="{StaticResource AriaToolbarButtonStyle}" Margin="{StaticResource AriaSpace1}" Click="ClearClick" AutomationProperties.Name="Clear download selection" />
    </StackPanel>
    </Grid>
</UserControl>
