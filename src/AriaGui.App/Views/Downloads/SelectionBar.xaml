<UserControl x:Class="AriaGui.App.Views.Downloads.SelectionBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:AriaGui.App.Icons">
    <StackPanel x:Name="SelectedActions" Orientation="Horizontal" Spacing="4" Padding="{StaticResource AriaSpace2}" Background="{ThemeResource AriaSelectionTintBrush}">
        <TextBlock x:Name="SelectedCountText" Text="0 selected" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,8,0" />
        <Button x:Name="ResumeButton" Command="{Binding ViewModel.BatchResumeCommand}" Style="{StaticResource AriaToolbarButtonStyle}" AutomationProperties.Name="Resume selected downloads">
            <StackPanel Orientation="Horizontal" Spacing="5"><icons:FluentIcon IconName="Play" FontSize="12" /><TextBlock Text="Resume" /></StackPanel>
        </Button>
        <Button x:Name="PauseButton" Command="{Binding ViewModel.BatchPauseCommand}" Style="{StaticResource AriaToolbarButtonStyle}" AutomationProperties.Name="Pause selected downloads">
            <StackPanel Orientation="Horizontal" Spacing="5"><icons:FluentIcon IconName="Pause" FontSize="12" /><TextBlock Text="Pause" /></StackPanel>
        </Button>
        <Button x:Name="RetryButton" Command="{Binding ViewModel.BatchRetryCommand}" Style="{StaticResource AriaToolbarButtonStyle}" AutomationProperties.Name="Retry selected downloads">
            <StackPanel Orientation="Horizontal" Spacing="5"><icons:FluentIcon IconName="Retry" FontSize="12" /><TextBlock Text="Retry" /></StackPanel>
        </Button>
        <DropDownButton x:Name="MoreButton" Padding="10,5" MinHeight="32" AutomationProperties.Name="More actions for selected downloads">
            <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="More" /><icons:FluentIcon IconName="ChevronDown" FontSize="10" /></StackPanel>
            <DropDownButton.Flyout>
                <MenuFlyout x:Name="MoreMenu">
                    <MenuFlyoutItem x:Name="OverflowRetry" Text="Retry" Command="{Binding ViewModel.BatchRetryCommand}" Visibility="Collapsed" />
                    <MenuFlyoutItem x:Name="RecoverItem" Text="Recover" Command="{Binding ViewModel.BatchRecoverCommand}" />
                    <MenuFlyoutItem Text="Restart fresh (keep partial files)" Command="{Binding ViewModel.BatchRestartFreshCommand}" />
                    <MenuFlyoutItem Text="Move earlier in queue" Click="SingleActionClick" Tag="MoveUp" />
                    <MenuFlyoutItem Text="Move later in queue" Click="SingleActionClick" Tag="MoveDown" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Open file" Click="SingleActionClick" Tag="OpenFile" />
                    <MenuFlyoutItem Text="Open folder" Click="SingleActionClick" Tag="OpenFolder" />
                    <MenuFlyoutItem Text="Remove from list" Command="{Binding ViewModel.BatchRemoveCommand}" />
                </MenuFlyout>
            </DropDownButton.Flyout>
        </DropDownButton>
        <Button x:Name="ClearButton" Content="Clear" Style="{StaticResource AriaToolbarButtonStyle}" Click="ClearClick" AutomationProperties.Name="Clear download selection" />
    </StackPanel>
</UserControl>
