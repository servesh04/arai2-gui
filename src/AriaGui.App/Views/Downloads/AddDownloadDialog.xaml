<ContentDialog x:Class="AriaGui.App.Views.Downloads.AddDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AriaGui.App.Views.Downloads"
    Title="Add download" PrimaryButtonText="Add download" SecondaryButtonText="Cancel"
    DefaultButton="Primary" Opened="DialogOpened" PrimaryButtonClick="AddClick" AllowDrop="True" DragOver="DialogDragOver" Drop="DialogDrop">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Spacing="{StaticResource AriaRadiusControl}" Padding="{StaticResource AriaSpace2}">
            <Button Content="Choose .torrent file…" Click="ChooseTorrentClick" Style="{StaticResource AriaSecondaryButtonStyle}" AutomationProperties.Name="Choose torrent file" />
            <TextBox x:Name="UrlsBox" Header="URL(s)" AcceptsReturn="True" MinHeight="88" TextWrapping="Wrap"
                     PlaceholderText="One http, https, or ftp link per line" TextChanged="UrlsChanged"
                     AutomationProperties.Name="Download URLs" />
            <TextBlock x:Name="UrlError" Foreground="{ThemeResource AriaDangerBrush}" FontSize="{StaticResource AriaMinimumFontSize}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            <TextBox x:Name="FileNameBox" Header="File name" Text="{x:Bind ViewModel.FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Output file name" />
            <TextBlock x:Name="FileNameHint" Text="Available when adding one URL." Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" Visibility="Collapsed" />
            <StackPanel x:Name="TorrentSection" Visibility="Collapsed" Spacing="{StaticResource AriaRadiusControl}">
                <TextBlock x:Name="TorrentName" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock x:Name="TorrentSummary" Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" TextWrapping="Wrap" />
                <Grid ColumnSpacing="{StaticResource AriaRadiusControl}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Files" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="SelectAllButton" Grid.Column="1" Content="Select all" Click="SelectAllClick" Style="{StaticResource AriaSecondaryButtonStyle}" />
                    <Button x:Name="ClearButton" Grid.Column="2" Content="Clear" Click="ClearSelectionClick" Style="{StaticResource AriaSecondaryButtonStyle}" />
                </Grid>
                <TreeView x:Name="FileTree" SelectionMode="Multiple" SelectionChanged="FileSelectionChanged" AutomationProperties.Name="Torrent file selection tree">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="{StaticResource AriaRadiusControl}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <local:MeasuredMiddleEllipsisTextBlock FullText="{Binding Content.Name}" ToolTipService.ToolTip="{Binding Content.RelativePath}" />
                                <TextBlock Grid.Column="1" Text="{Binding Content.SizeLabel}" FontSize="{StaticResource AriaMinimumFontSize}" Foreground="{ThemeResource AriaTextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.Resources>
                        <StaticResource x:Key="ListViewItemCheckBoxBrush" ResourceKey="AriaListViewItemCheckBoxBrush" />
                        <StaticResource x:Key="ListViewItemCheckBoxBorderBrush" ResourceKey="AriaListViewItemCheckBoxBorderBrush" />
                        <StaticResource x:Key="ListViewItemCheckBoxSelectedBrush" ResourceKey="AriaListViewItemCheckBoxSelectedBrush" />
                        <StaticResource x:Key="ListViewItemCheckBrush" ResourceKey="AriaListViewItemCheckBrush" />
                    </TreeView.Resources>
                </TreeView>
                <TextBlock x:Name="SelectionSummary" FontWeight="SemiBold" FontSize="{StaticResource AriaMinimumFontSize}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="SpaceSummary" Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <InfoBar x:Name="PrivacyNotice" IsClosable="False" Severity="Warning" Message="• Peers and trackers can see your IP address; a VPN or proxy may not cover peer traffic.&#10;• Windows Firewall may prompt for aria2.&#10;• Seeding stops when downloading finishes. DHT, peer exchange and local discovery stay off." />
                <StackPanel x:Name="PrivacySummary" Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}" Visibility="Collapsed">
                    <TextBlock Text="Peers can see your IP address." VerticalAlignment="Center" />
                    <Button Content="Details" Click="PrivacyDetailsClick" Style="{StaticResource AriaSecondaryButtonStyle}" AutomationProperties.Name="Show BitTorrent privacy details" />
                </StackPanel>
                <CheckBox x:Name="PrivacyConsent" Checked="ConsentChanged" Unchecked="ConsentChanged" AutomationProperties.Name="Accept torrent network and privacy notice">
                    <TextBlock Text="I understand the peer and tracker exposure and want to add this torrent." TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Text="Only download material you have permission to share. AriaGUI provides no search or tracker list." Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" Header="Save folder" Text="{x:Bind ViewModel.DirectoryPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="FolderChanged" AutomationProperties.Name="Save folder" />
                <Button Grid.Column="1" Content="Browse…" Command="{x:Bind ViewModel.BrowseCommand}" VerticalAlignment="Bottom"
                        Style="{StaticResource AriaSecondaryButtonStyle}" AutomationProperties.Name="Browse for save folder" />
            </Grid>
            <TextBlock x:Name="FolderStatus" FontSize="{StaticResource AriaMinimumFontSize}" Foreground="{ThemeResource AriaTextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ToggleSwitch x:Name="StartPaused" Header="Start paused" OffContent="Off" OnContent="On" IsEnabled="False"
                          ToolTipService.ToolTip="Not available yet" AutomationProperties.Name="Start download paused" />
            <TextBlock x:Name="StartPausedHint" Text="Adds the transfer without starting it. Not available yet." Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" TextWrapping="Wrap" />
            <Expander x:Name="AdvancedOptions" Header="Advanced">
                <StackPanel Spacing="12" Padding="{StaticResource AriaSpace2}">
                    <TextBox Header="Referrer" IsEnabled="False" ToolTipService.ToolTip="Not available yet" />
                    <TextBox Header="Cookies" IsEnabled="False" ToolTipService.ToolTip="Not available yet" />
                    <TextBlock Text="Sent only to this download's server. Never saved to history." FontSize="{StaticResource AriaMinimumFontSize}" TextWrapping="Wrap" />
                    <TextBox Header="Headers" AcceptsReturn="True" IsEnabled="False" ToolTipService.ToolTip="Not available yet" />
                </StackPanel>
            </Expander>
            <TextBlock x:Name="TorrentError" Foreground="{ThemeResource AriaDangerBrush}" FontSize="{StaticResource AriaMinimumFontSize}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
