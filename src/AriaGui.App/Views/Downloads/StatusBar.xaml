<UserControl x:Class="AriaGui.App.Views.Downloads.StatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:AriaGui.App.Icons">
    <Grid x:Name="Footer" Padding="{StaticResource AriaSpace2}" ColumnSpacing="{StaticResource AriaRadiusOuter}" BorderBrush="{ThemeResource AriaBorderBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource AriaSurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="EngineButton" Padding="0" MinHeight="{StaticResource AriaRowHeightCompact}" Background="Transparent" BorderThickness="0"
                ToolTipService.ToolTip="Show download engine status" AutomationProperties.Name="Download engine status" Click="EngineClick">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}">
                <Ellipse x:Name="EngineDot" Width="{StaticResource AriaRadiusControl}" Height="{StaticResource AriaRadiusControl}" VerticalAlignment="Center" />
                <TextBlock x:Name="EngineText" Text="Engine stopped" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <DropDownButton x:Name="FooterStatus" Grid.Column="1" Content="Status" Visibility="Collapsed" HorizontalAlignment="Left" Padding="{StaticResource AriaSpace1}" MinHeight="{StaticResource AriaRowHeightCompact}" AutomationProperties.Name="Full engine and transfer status">
            <DropDownButton.Flyout>
                <Flyout Opening="CompactStatusOpening" Closed="CompactStatusClosed">
                    <StackPanel Spacing="{StaticResource AriaRadiusControl}">
                        <TextBlock x:Name="CompactEngineText" Text="Engine stopped" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary.QueueStatus}" />
                    </StackPanel>
                </Flyout>
            </DropDownButton.Flyout>
        </DropDownButton>
        <Button x:Name="QueueButton" Grid.Column="1" Padding="{StaticResource AriaSpace1}" Background="Transparent" BorderThickness="0" Click="QueueClick" ToolTipService.ToolTip="Filter active or waiting downloads" AutomationProperties.Name="Filter active or waiting downloads">
            <TextBlock x:Name="TotalText" Text="{Binding Summary.QueueStatus}" TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center" />
        </Button>
        <TextBlock x:Name="ConnectionText" Grid.Column="2" Text="{Binding ViewModel.ConnectionMessage}" Visibility="Collapsed" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}" VerticalAlignment="Center">
            <icons:FluentIcon IconName="Download" Foreground="{ThemeResource AriaAccentBrush}" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="SpeedText" Text="—" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" ToolTipService.ToolTip="Total download speed" />
        </StackPanel>
        <Button x:Name="SpeedLimitButton" Grid.Column="4" Style="{StaticResource AriaToolbarButtonStyle}" Click="SpeedLimitClick" ToolTipService.ToolTip="Choose speed limit" AutomationProperties.Name="Choose speed limit">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AriaRadiusControl}"><icons:FluentIcon IconName="Speed" /><TextBlock x:Name="SpeedLimitText" Text="Unlimited" /></StackPanel>
        </Button>
        <TextBlock x:Name="SpeedLimitReadOnly" Grid.Column="4" Text="Unlimited" VerticalAlignment="Center" Foreground="{ThemeResource AriaTextSecondaryBrush}" ToolTipService.ToolTip="Speed presets are unavailable in this build." AutomationProperties.Name="Speed limit, Unlimited" />
    </Grid>
</UserControl>
