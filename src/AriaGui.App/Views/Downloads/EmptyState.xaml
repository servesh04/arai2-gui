<UserControl x:Class="AriaGui.App.Views.Downloads.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel x:Name="EmptyRoot" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsHitTestVisible="False" Visibility="Collapsed">
        <TextBlock Text="{Binding ViewModel.EmptyTitle}" FontSize="16" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding ViewModel.EmptyMessage}" FontSize="{StaticResource AriaMinimumFontSize}" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
