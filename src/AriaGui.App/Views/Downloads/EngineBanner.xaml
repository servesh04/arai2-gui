<UserControl x:Class="AriaGui.App.Views.Downloads.EngineBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <InfoBar x:Name="Banner" IsOpen="False" IsClosable="False" Margin="{StaticResource AriaSpace2}"
             AutomationProperties.LiveSetting="Assertive">
        <InfoBar.ActionButton>
            <Button x:Name="RestartButton" Content="Restart engine" Style="{StaticResource AriaSecondaryButtonStyle}"
                    Click="RestartClick" AutomationProperties.Name="Restart download engine" Visibility="Collapsed" />
        </InfoBar.ActionButton>
        <InfoBar.Content>
            <ProgressRing x:Name="RestartProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed"
                          AutomationProperties.Name="Restarting download engine" />
        </InfoBar.Content>
    </InfoBar>
</UserControl>
