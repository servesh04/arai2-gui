<UserControl x:Class="AriaGui.App.Views.Downloads.TorrentWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource AriaSpace3}" RowSpacing="{StaticResource AriaRadiusControl}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="3*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="{StaticResource AriaRadiusControl}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Torrents" FontWeight="SemiBold" />
                <TextBlock Text="Selected files are published after piece verification. Seeding stops when downloading finishes."
                    TextWrapping="Wrap" Foreground="{ThemeResource AriaTextSecondaryBrush}" FontSize="{StaticResource AriaMinimumFontSize}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Add torrent…" Click="AddClick" Style="{StaticResource AriaPrimaryButtonStyle}"
                    AutomationProperties.Name="Add torrent" ToolTipService.ToolTip="Choose files now; the download engine must be running to start the torrent." />
            <Button Grid.Column="2" Content="Downloads" Click="DownloadsClick" Style="{StaticResource AriaSecondaryButtonStyle}"
                    AutomationProperties.Name="Show downloads" />
        </Grid>
        <Grid Grid.Row="1">
            <ListView x:Name="TorrentList" SelectionMode="Single" SelectionChanged="TorrentSelectionChanged"
                      AutomationProperties.Name="Torrent transfers">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="{StaticResource AriaRadiusControl}" Padding="{StaticResource AriaSpace1}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                            <TextBlock Grid.Column="1" Text="{Binding Stage}" Foreground="{ThemeResource AriaTextSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyMessage" Text="No torrents yet. Add a local .torrent file to choose its files and destination."
                       TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="2">
            <TextBlock x:Name="SelectionMessage" Text="Select a torrent to see its files and progress."
                       VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
            <Grid x:Name="DetailsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <InfoBar x:Name="OperationNotice" IsOpen="False" IsClosable="False" Severity="Warning" />
                <Button x:Name="DispatchButton" Grid.Row="1" Content="Start torrent" Click="DispatchClick" HorizontalAlignment="Left"
                        Visibility="Collapsed" Style="{StaticResource AriaSecondaryButtonStyle}" />
                <local:TorrentStatusView x:Name="TorrentDetails" Grid.Row="2" xmlns:local="using:AriaGui.App.Views.Downloads" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
