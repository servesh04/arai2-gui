<Page x:Class="AriaGui.App.Views.Notifications.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:AriaGui.App.ViewModels"
      Loaded="PageLoaded">
    <Grid Padding="{StaticResource AriaSpace4}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="{StaticResource AriaSpace2}">
            <TextBlock Text="Notifications" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.UnreadSummary, Mode=OneWay}"
                       Foreground="{ThemeResource AriaTextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="Refresh" Click="RefreshClick"
                    Style="{StaticResource AriaSecondaryButtonStyle}"
                    VerticalAlignment="Center" Margin="{StaticResource AriaSpace2}" />
            <Button Content="Mark all read" Click="MarkAllReadClick"
                    IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                    Style="{StaticResource AriaSecondaryButtonStyle}"
                    Margin="{StaticResource AriaSpace2}" />
            <Button Content="Clear all" Click="DismissAllClick"
                    IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                    Style="{StaticResource AriaSecondaryButtonStyle}"
                    Margin="{StaticResource AriaSpace2}" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                   Margin="{StaticResource AriaSpace2}" />

        <Grid Grid.Row="3">
            <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       TextWrapping="Wrap" Foreground="{ThemeResource AriaTextSecondaryBrush}"
                       Margin="{StaticResource AriaSpace2}" />
            <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      SelectionMode="None" AutomationProperties.Name="Notification history">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="UseSystemFocusVisuals" Value="True" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotificationRowViewModel">
                        <Border Style="{StaticResource AriaCardStyle}" Margin="{StaticResource AriaSpace2}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind UnreadText}" Margin="{StaticResource AriaSpace2}"
                                               Foreground="{ThemeResource AriaAccentBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind TimeText}"
                                           Foreground="{ThemeResource AriaTextSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind DisplayName}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           ToolTipService.ToolTip="{x:Bind DisplayName}"
                                           Margin="{StaticResource AriaSpace2}" />
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind Detail}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource AriaTextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="View" Tag="{x:Bind}" Click="ViewClick"
                                            IsEnabled="{x:Bind CanViewDownload}"
                                            AutomationProperties.Name="View download"
                                            Style="{StaticResource AriaSecondaryButtonStyle}"
                                            Margin="{StaticResource AriaSpace2}" />
                                    <Button Content="Read" Tag="{x:Bind}" Click="MarkReadClick"
                                            IsEnabled="{x:Bind IsUnread}"
                                            AutomationProperties.Name="Mark notification read"
                                            Style="{StaticResource AriaSecondaryButtonStyle}"
                                            Margin="{StaticResource AriaSpace2}" />
                                    <Button Content="Dismiss" Tag="{x:Bind}" Click="DismissClick"
                                            Style="{StaticResource AriaSecondaryButtonStyle}"
                                            Margin="{StaticResource AriaSpace2}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Button Grid.Row="4" Content="Load older notifications" Click="LoadMoreClick"
                IsEnabled="{x:Bind ViewModel.HasMore, Mode=OneWay}"
                Visibility="{x:Bind HasMoreVisibility(ViewModel.HasMore), Mode=OneWay}"
                HorizontalAlignment="Left" Style="{StaticResource AriaSecondaryButtonStyle}"
                Margin="{StaticResource AriaSpace2}" />
    </Grid>
</Page>
