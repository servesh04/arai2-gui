<Page x:Class="AriaGui.App.Views.DownloadsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:AriaGui.App.ViewModels">
    <Page.Resources>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5" /><Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" /><Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" /><Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="Margin" Value="8,0" />
        </Style>
    </Page.Resources>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindInvoked" />
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllInvoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="AddInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <MenuBar Padding="4,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <MenuBarItem Title="File"><MenuFlyoutItem Text="Add download…" Click="AddClick" /><MenuFlyoutSeparator /><MenuFlyoutItem Text="Exit" Click="ExitClick" /></MenuBarItem>
            <MenuBarItem Title="Edit"><MenuFlyoutItem Text="Select all visible" Click="SelectAllClick" /><MenuFlyoutItem Text="Clear selection" Click="ClearSelectionClick" /></MenuBarItem>
            <MenuBarItem x:Name="TransferMenu" Title="Transfer" IsEnabled="False">
                <MenuFlyoutItem Text="Resume" Command="{x:Bind ViewModel.BatchResumeCommand}" /><MenuFlyoutItem Text="Pause" Command="{x:Bind ViewModel.BatchPauseCommand}" />
                <MenuFlyoutItem Text="Retry" Command="{x:Bind ViewModel.BatchRetryCommand}" /><MenuFlyoutItem Text="Recover" Command="{x:Bind ViewModel.BatchRecoverCommand}" />
                <MenuFlyoutSeparator /><MenuFlyoutItem Text="Move earlier in queue" Click="SingleActionClick" Tag="MoveUp" /><MenuFlyoutItem Text="Move later in queue" Click="SingleActionClick" Tag="MoveDown" />
                <MenuFlyoutSeparator /><MenuFlyoutItem Text="Stop transfer (keep files and history)" Command="{x:Bind ViewModel.BatchRemoveCommand}" />
                <MenuFlyoutItem Text="Open file" Click="SingleActionClick" Tag="OpenFile" /><MenuFlyoutItem Text="Open folder" Click="SingleActionClick" Tag="OpenFolder" />
            </MenuBarItem>
            <MenuBarItem Title="View"><ToggleMenuFlyoutItem x:Name="DetailsToggle" Text="Details pane" IsChecked="True" Click="DetailsClick" /><MenuFlyoutItem x:Name="InspectorDetailsMenu" Text="Transfer details…" IsEnabled="False" Click="InspectorDetailsClick" /><MenuFlyoutItem Text="Columns..." Click="ColumnsClick" /><MenuFlyoutItem Text="Reset pane sizes" Click="ResetPanesClick" /></MenuBarItem>
            <MenuBarItem Title="Tools"><MenuFlyoutItem Text="Preferences…" Click="PreferencesClick" /><MenuFlyoutItem Text="Download engine…" Click="EngineClick" /></MenuBarItem>
            <MenuBarItem Title="Help"><MenuFlyoutItem Text="Keyboard shortcuts" Click="HelpClick" /></MenuBarItem>
        </MenuBar>
        <Grid x:Name="Toolbar" SizeChanged="ShellSizeChanged" Grid.Row="1" Padding="10,6" ColumnSpacing="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="PrimaryActions" Orientation="Horizontal" Spacing="6"><Button x:Name="AddButton" Content="＋ Add download" Click="AddClick" Style="{StaticResource AccentButtonStyle}" Padding="12,5" FontSize="12" MinHeight="30" /><Button x:Name="FiltersButton" Click="FiltersClick" Style="{StaticResource SmallButton}" AutomationProperties.Name="Choose transfer status and history filters"><TextBlock x:Name="FilterCaption" Text="Filters" MaxWidth="130" TextTrimming="CharacterEllipsis" /></Button></StackPanel>
            <StackPanel x:Name="SelectedActions" Grid.Column="1" Orientation="Horizontal" Spacing="3">
                <Button Content="Resume" Command="{x:Bind ViewModel.BatchResumeCommand}" Style="{StaticResource SmallButton}" />
                <Button Content="Pause" Command="{x:Bind ViewModel.BatchPauseCommand}" Style="{StaticResource SmallButton}" />
                <Button x:Name="RetryButton" Content="Retry" Command="{x:Bind ViewModel.BatchRetryCommand}" Style="{StaticResource SmallButton}" />
                <DropDownButton Content="More" Padding="10,5" MinHeight="30" FontSize="12">
                    <DropDownButton.Flyout><MenuFlyout x:Name="MoreMenu"><MenuFlyoutItem x:Name="OverflowRetry" Text="Retry" Command="{x:Bind ViewModel.BatchRetryCommand}" Visibility="Collapsed" />
                        <MenuFlyoutItem Text="Recover" Command="{x:Bind ViewModel.BatchRecoverCommand}" />
                        <MenuFlyoutItem Text="Restart fresh (keep partial files)" Command="{x:Bind ViewModel.BatchRestartFreshCommand}" />
                        <MenuFlyoutItem Text="Move earlier in queue" Click="SingleActionClick" Tag="MoveUp" /><MenuFlyoutItem Text="Move later in queue" Click="SingleActionClick" Tag="MoveDown" />
                        <MenuFlyoutSeparator /><MenuFlyoutItem Text="Stop transfer (keep files and history)" Command="{x:Bind ViewModel.BatchRemoveCommand}" />
                        <MenuFlyoutItem Text="Open file" Click="SingleActionClick" Tag="OpenFile" /><MenuFlyoutItem Text="Open folder" Click="SingleActionClick" Tag="OpenFolder" />
                    </MenuFlyout></DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Column="2" MinWidth="100" HorizontalAlignment="Right" FontSize="12" MinHeight="30"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                     PlaceholderText="Filter transfers… (Ctrl+F)" AutomationProperties.Name="Search downloads and history" />
        </Grid>
        <ScrollViewer x:Name="NoticeScroller" Grid.Row="2" MaxHeight="120" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock x:Name="BatchMessageText" TextWrapping="Wrap" Text="{x:Bind ViewModel.BatchMessage, Mode=OneWay}" FontSize="12" Margin="10,2" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="BatchDetailsButton" Content="Batch results..." Click="BatchDetailsClick" Visibility="Collapsed" HorizontalAlignment="Left" Margin="10,0" Style="{StaticResource SmallButton}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasCompletion, Mode=OneWay}" Severity="Success" IsClosable="True" Message="{x:Bind ViewModel.CompletionMessage, Mode=OneWay}" />
        </StackPanel></ScrollViewer>
        <Grid x:Name="Workspace" Grid.Row="3" SizeChanged="WorkspaceSizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="160" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="SidebarHost" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Padding="6,12,6,8">
                        <TextBlock Text="TRANSFERS" FontSize="11" FontWeight="SemiBold" Margin="10,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView x:Name="StatusFilters" SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.Name="Download status filter">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="10,4" /><Setter Property="FontSize" Value="12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                            <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="All transfers" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="All transfers" /><TextBlock Grid.Column="1" FontSize="12" HorizontalAlignment="Right" /></Grid>
<Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Downloading" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Downloading" /><TextBlock Grid.Column="1" FontSize="12" HorizontalAlignment="Right" /></Grid>
<Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Waiting" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Waiting" /><TextBlock Grid.Column="1" FontSize="12" HorizontalAlignment="Right" /></Grid>
<Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Paused" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Paused" /><TextBlock Grid.Column="1" FontSize="12" HorizontalAlignment="Right" /></Grid>
<Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Needs recovery" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Needs recovery" /><TextBlock Grid.Column="1" FontSize="12" HorizontalAlignment="Right" /></Grid>
<Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Completed" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Completed" /><TextBlock Grid.Column="1" FontSize="12" HorizontalAlignment="Right" /></Grid>
<Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Failed" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Failed" /><TextBlock Grid.Column="1" FontSize="12" HorizontalAlignment="Right" /></Grid>
<Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Stopped" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Stopped" /><TextBlock Grid.Column="1" FontSize="12" HorizontalAlignment="Right" /></Grid>
                        </ListView>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="8,0" />
                        <CheckBox Content="Saved history" FontSize="12" MinWidth="0" Margin="8,0" IsChecked="{x:Bind ViewModel.IsHistoryView, Mode=TwoWay}" AutomationProperties.Name="Browse completed, failed, and removed history" />
                        <TextBlock Text="Live view includes unfinished transfers and up to 100 recent records." TextWrapping="Wrap" FontSize="11" Margin="10,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Preferences…" Click="PreferencesClick" Style="{StaticResource SmallButton}" Margin="8,4" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Thumb Grid.Column="1" x:Name="SidebarSplitter" IsTabStop="True" UseSystemFocusVisuals="True" DragDelta="SidebarDragDelta" KeyDown="SidebarKeyDown" AutomationProperties.Name="Resize sidebar; use left and right arrows" AutomationProperties.HelpText="Preferred sidebar width in device-independent pixels" Background="{ThemeResource CardStrokeColorDefaultBrush}">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" /></ControlTemplate></Thumb.Template>
            </Thumb>
            <Grid x:Name="TransferWorkspace" Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition x:Name="DetailsGripRow" Height="6" /><RowDefinition x:Name="DetailsRow" Height="180" /></Grid.RowDefinitions>
                <Grid x:Name="HistoryBar" Padding="10,4" ColumnSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.BrowserMessage, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind ViewModel.BrowserMessage, Mode=OneWay}" />
                    <StackPanel x:Name="HistoryActions" Grid.Column="1" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ViewModel.IsHistoryView, Mode=OneWay}">
                        <Button Content="‹" Command="{x:Bind ViewModel.PreviousPageCommand}" Style="{StaticResource SmallButton}" AutomationProperties.Name="Previous history page" />
                        <Button Content="›" Command="{x:Bind ViewModel.NextPageCommand}" Style="{StaticResource SmallButton}" AutomationProperties.Name="Next history page" />
                        <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshHistoryCommand}" Style="{StaticResource SmallButton}" AutomationProperties.Name="Refresh history" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="TableScroller" SizeChanged="TableViewportChanged" ViewChanged="TableViewportViewChanged" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid x:Name="TableCanvas" HorizontalAlignment="Left">
                            <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid x:Name="TableHeader" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="220" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Name" Style="{StaticResource CellText}" /><TextBlock Grid.Column="1" Text="Size" Style="{StaticResource CellText}" /><TextBlock Grid.Column="2" Text="Progress" Style="{StaticResource CellText}" />
                                <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource CellText}" /><TextBlock Grid.Column="4" Text="Down speed" Style="{StaticResource CellText}" /><TextBlock Grid.Column="5" Text="ETA" Style="{StaticResource CellText}" />
                            </Grid>
                            <ListView x:Name="TransferList" Padding="0" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Downloads}" SelectionMode="Extended" SelectionChanged="TransferSelectionChanged" RightTapped="TransferRightTapped" AutomationProperties.Name="Transfers" ContainerContentChanging="DownloadContainerChanging" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" CacheLength="1" /></ItemsPanelTemplate></ListView.ItemsPanel>
                                <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="32" /></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate><DataTemplate x:DataType="vm:DownloadItemViewModel">
                                    <Grid BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <CheckBox Tag="TransferSelectionCheck" Loaded="RowCheckLoaded" Click="RowCheckClick" Tapped="RowCheckTapped" MinWidth="0" MinHeight="0" Padding="0" Margin="3,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}" />
                                        <Grid Tag="TransferDataGrid" Grid.Column="1" Loaded="RowLoaded" MinHeight="31" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="220" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                        <TextBlock Tag="0" Text="{x:Bind FileName}" Style="{StaticResource CellText}" ToolTipService.ToolTip="{x:Bind FileName}" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Tag="1" Grid.Column="1" Text="{x:Bind TotalSizeLabel, Mode=OneWay}" Style="{StaticResource CellText}" />
                                        <Grid Tag="2" Grid.Column="2" Margin="8,0" VerticalAlignment="Center"><ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Height="4" VerticalAlignment="Bottom" AutomationProperties.Name="{x:Bind FileName}" /><TextBlock Text="{x:Bind ProgressLabel, Mode=OneWay}" FontSize="11" Margin="0,0,0,6" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" /></Grid>
                                        <TextBlock Tag="3" Grid.Column="3" Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource CellText}" ToolTipService.ToolTip="{x:Bind Status, Mode=OneWay}" />
                                        <TextBlock Tag="4" Grid.Column="4" Text="{x:Bind SpeedLabel, Mode=OneWay}" Style="{StaticResource CellText}" /><TextBlock Tag="5" Grid.Column="5" Text="{x:Bind EtaLabel, Mode=OneWay}" Style="{StaticResource CellText}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsHitTestVisible="False" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" FontSize="16" HorizontalAlignment="Center" /><TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Thumb Grid.Row="2" x:Name="DetailsSplitter" IsTabStop="True" UseSystemFocusVisuals="True" DragDelta="DetailsDragDelta" KeyDown="DetailsKeyDown" AutomationProperties.Name="Resize details pane; use up and down arrows" AutomationProperties.HelpText="Preferred details height in device-independent pixels" Background="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" /></ControlTemplate></Thumb.Template>
                </Thumb>
                <Grid x:Name="Inspector" Grid.Row="3" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="TRANSFER DETAILS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SelectionHint" Grid.Row="1" Text="Select a transfer to inspect its progress, destination and available actions." TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                    <ScrollViewer x:Name="DetailsHost" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                        <StackPanel Spacing="7">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel x:Name="InspectorMetadata" Spacing="6"><TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding SizeLabel}" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding QueueLabel}" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                            <TextBlock Text="{Binding Source}" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" /><TextBlock Text="{Binding Destination}" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" /><TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="6"><Button x:Name="InspectorOpenFile" Content="Open file" Click="SingleActionClick" Tag="OpenFile" Style="{StaticResource SmallButton}" /><Button x:Name="InspectorOpenFolder" Content="Open folder" Click="SingleActionClick" Tag="OpenFolder" Style="{StaticResource SmallButton}" /></StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
        <Grid x:Name="Footer" Grid.Row="4" Padding="10,5" ColumnSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Click="EngineClick" Padding="0" MinHeight="24" Background="Transparent" BorderThickness="0" FontSize="11" ToolTipService.ToolTip="{x:Bind Engine.Message, Mode=OneWay}"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Engine" /><TextBlock Text="{x:Bind Engine.StatusLabel, Mode=OneWay}" FontWeight="SemiBold" /></StackPanel></Button>
            <DropDownButton x:Name="FooterStatus" Grid.Column="1" Content="Status" Visibility="Collapsed" HorizontalAlignment="Left" Padding="4,0" MinHeight="24" FontSize="11" AutomationProperties.Name="Full connection status and transfer count"><DropDownButton.Flyout><Flyout><StackPanel Spacing="8" MaxWidth="320"><TextBlock Text="{x:Bind ViewModel.ConnectionMessage, Mode=OneWay}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind Summary.Total, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel></Flyout></DropDownButton.Flyout></DropDownButton><TextBlock x:Name="ConnectionText" ToolTipService.ToolTip="{x:Bind ViewModel.ConnectionMessage, Mode=OneWay}" Tag="1" Grid.Column="1" Text="{x:Bind ViewModel.ConnectionMessage, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock x:Name="TotalText" TextTrimming="CharacterEllipsis" MaxWidth="180" ToolTipService.ToolTip="{x:Bind Summary.Total, Mode=OneWay}" Tag="2" Grid.Column="2" Text="{x:Bind Summary.Total, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><TextBlock Text="↓" FontSize="12" /><TextBlock Text="{x:Bind Summary.Speed, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" /></StackPanel>
        </Grid>
    </Grid>
</Page>




