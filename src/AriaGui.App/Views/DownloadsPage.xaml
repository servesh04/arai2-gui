<Page x:Class="AriaGui.App.Views.DownloadsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:downloads="using:AriaGui.App.Views.Downloads">
    <Grid x:Name="Workspace" Background="{ThemeResource AriaBackgroundBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindInvoked" />
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllInvoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="AddInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="184" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border x:Name="SidebarHost" Grid.Column="0" Background="{ThemeResource AriaBackgroundBrush}">
            <downloads:FiltersRail x:Name="FiltersRailControl" SettingsRequested="PreferencesClick" />
        </Border>
        <Thumb Grid.Column="1" x:Name="SidebarSplitter" IsTabStop="True" UseSystemFocusVisuals="True" DragDelta="SidebarDragDelta" KeyDown="SidebarKeyDown" AutomationProperties.Name="Resize sidebar; use left and right arrows" AutomationProperties.HelpText="Preferred sidebar width in device-independent pixels" Background="{ThemeResource AriaBorderBrush}">
            <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" /></ControlTemplate></Thumb.Template>
        </Thumb>
        <Border x:Name="ContentSurface" Grid.Column="2" Margin="0,8,8,0" Background="{ThemeResource AriaSurfaceBrush}" BorderBrush="{ThemeResource AriaBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource AriaOuterCornerRadius}">
            <Grid>
            <Grid x:Name="DownloadsContent">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <MenuBar Padding="4,0" Background="{ThemeResource AriaSurfaceRaisedBrush}">
                    <MenuBarItem Title="File"><MenuFlyoutItem Text="Add download…" Click="AddClick" /><MenuFlyoutSeparator /><MenuFlyoutItem Text="Exit" Click="ExitClick" /></MenuBarItem>
                    <MenuBarItem Title="Edit"><MenuFlyoutItem Text="Select all visible" Click="SelectAllClick" /><MenuFlyoutItem Text="Clear selection" Click="ClearSelectionClick" /></MenuBarItem>
                    <MenuBarItem x:Name="TransferMenu" Title="Transfer" IsEnabled="False">
                        <MenuFlyoutItem Text="Resume" Command="{x:Bind ViewModel.BatchResumeCommand}" /><MenuFlyoutItem Text="Pause" Command="{x:Bind ViewModel.BatchPauseCommand}" />
                        <MenuFlyoutItem Text="Retry" Command="{x:Bind ViewModel.BatchRetryCommand}" /><MenuFlyoutItem Text="Recover" Command="{x:Bind ViewModel.BatchRecoverCommand}" />
                        <MenuFlyoutSeparator /><MenuFlyoutItem Text="Move earlier in queue" Click="SingleActionClick" Tag="MoveUp" /><MenuFlyoutItem Text="Move later in queue" Click="SingleActionClick" Tag="MoveDown" />
                        <MenuFlyoutSeparator /><MenuFlyoutItem Text="Stop transfer (keep files and history)" Command="{x:Bind ViewModel.BatchRemoveCommand}" />
                        <MenuFlyoutItem Text="Open file" Click="SingleActionClick" Tag="OpenFile" /><MenuFlyoutItem Text="Open folder" Click="SingleActionClick" Tag="OpenFolder" />
                    </MenuBarItem>
                    <MenuBarItem Title="View"><ToggleMenuFlyoutItem x:Name="DetailsToggle" Text="Details pane" IsChecked="True" Click="DetailsClick" /><MenuFlyoutItem x:Name="InspectorDetailsMenu" Text="Transfer details…" IsEnabled="False" Click="InspectorDetailsClick" /><MenuFlyoutItem Text="Columns..." Click="ColumnsClick" /><MenuFlyoutItem Text="Reset pane sizes" Click="ResetPanesClick" /></MenuBarItem>
                    <MenuBarItem Title="Tools"><MenuFlyoutItem Text="Preferences…" Click="PreferencesClick" /><MenuFlyoutItem Text="Download engine…" Click="EngineClick" /></MenuBarItem>
                    <MenuBarItem x:Name="HelpMenu" Title="Help"><MenuFlyoutItem Text="Keyboard shortcuts" Click="HelpClick" /></MenuBarItem>
                </MenuBar>
                <downloads:DownloadsToolbar x:Name="DownloadsToolbarControl" Grid.Row="1" AddRequested="AddClick" FiltersRequested="FiltersClick" SizeChanged="ShellSizeChanged" />
                <downloads:SelectionBar x:Name="SelectionBarControl" Grid.Row="2" Visibility="Collapsed" SingleActionRequested="SingleActionClick" />
                <downloads:EngineBanner x:Name="EngineBannerControl" Grid.Row="3" />
                <ScrollViewer x:Name="NoticeScroller" Grid.Row="4" MaxHeight="120" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock x:Name="BatchMessageText" TextWrapping="Wrap" Text="{x:Bind ViewModel.BatchMessage, Mode=OneWay}" FontSize="{StaticResource AriaMinimumFontSize}" Margin="10,2" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="BatchDetailsButton" Content="Batch results..." Click="BatchDetailsClick" Visibility="Collapsed" HorizontalAlignment="Left" Margin="10,0" Style="{StaticResource AriaSecondaryButtonStyle}" />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasCompletion, Mode=OneWay}" Severity="Success" IsClosable="True" Message="{x:Bind ViewModel.CompletionMessage, Mode=OneWay}" />
                </StackPanel></ScrollViewer>
                <Grid x:Name="TransferWorkspace" Grid.Row="5" SizeChanged="WorkspaceSizeChanged">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition x:Name="DetailsGripRow" Height="6" /><RowDefinition x:Name="DetailsRow" Height="180" /></Grid.RowDefinitions>
                    <Grid x:Name="HistoryBar" Padding="10,4" ColumnSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.BrowserMessage, Mode=OneWay}" FontSize="{StaticResource AriaMinimumFontSize}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind ViewModel.BrowserMessage, Mode=OneWay}" />
                        <StackPanel x:Name="HistoryActions" Grid.Column="1" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ViewModel.IsHistoryView, Mode=OneWay}">
                            <Button Content="‹" Command="{x:Bind ViewModel.PreviousPageCommand}" Style="{StaticResource AriaToolbarButtonStyle}" AutomationProperties.Name="Previous history page" />
                            <Button Content="›" Command="{x:Bind ViewModel.NextPageCommand}" Style="{StaticResource AriaToolbarButtonStyle}" AutomationProperties.Name="Next history page" />
                            <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshHistoryCommand}" Style="{StaticResource AriaToolbarButtonStyle}" AutomationProperties.Name="Refresh history" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1"><downloads:DownloadsTable x:Name="DownloadsTableControl" /><downloads:EmptyState x:Name="EmptyStateControl" /></Grid>
                    <Thumb Grid.Row="2" x:Name="DetailsSplitter" IsTabStop="True" UseSystemFocusVisuals="True" DragDelta="DetailsDragDelta" KeyDown="DetailsKeyDown" AutomationProperties.Name="Resize details pane; use up and down arrows" AutomationProperties.HelpText="Preferred details height in device-independent pixels" Background="{ThemeResource AriaBorderBrush}">
                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" /></ControlTemplate></Thumb.Template>
                    </Thumb>
                    <downloads:DetailsPane x:Name="DetailsPaneControl" Grid.Row="3" SingleActionRequested="SingleActionClick" />
                </Grid>
                <downloads:StatusBar x:Name="StatusBarControl" Grid.Row="6" EngineRequested="EngineClick" />
            </Grid>
            <downloads:HandoffToast x:Name="HandoffToastControl" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
            <ContentControl x:Name="SettingsHost" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>

