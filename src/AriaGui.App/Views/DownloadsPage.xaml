<Page x:Class="AriaGui.App.Views.DownloadsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:downloads="using:AriaGui.App.Views.Downloads">
    <Grid x:Name="Workspace" Background="{ThemeResource AriaBackgroundBrush}" AllowDrop="True" DragOver="WorkspaceDragOver" Drop="WorkspaceDrop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindInvoked" />
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllInvoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="AddInvoked" />
            <KeyboardAccelerator Key="Menu" Invoked="MainMenuInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="184" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border x:Name="SidebarHost" Grid.Column="0" Background="{ThemeResource AriaBackgroundBrush}">
            <downloads:FiltersRail x:Name="FiltersRailControl" SettingsRequested="PreferencesClick" />
        </Border>
        <Thumb Grid.Column="1" x:Name="SidebarSplitter" IsTabStop="True" UseSystemFocusVisuals="True" DragDelta="SidebarDragDelta" KeyDown="SidebarKeyDown" AutomationProperties.Name="Resize sidebar; use left and right arrows" AutomationProperties.HelpText="Preferred sidebar width in device-independent pixels" Background="{ThemeResource AriaBorderBrush}">
            <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" /></ControlTemplate></Thumb.Template>
        </Thumb>
        <Border x:Name="ContentSurface" Grid.Column="2" Margin="{StaticResource AriaSpace2}" Background="{ThemeResource AriaSurfaceBrush}" BorderBrush="{ThemeResource AriaBorderBrush}" BorderThickness="{StaticResource AriaStandardBorderThickness}" CornerRadius="{StaticResource AriaOuterCornerRadius}">
            <Grid>
            <Grid x:Name="DownloadsContent">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Background="{ThemeResource AriaSurfaceRaisedBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <DropDownButton x:Name="AppMenuButton" Style="{StaticResource AriaSecondaryButtonStyle}" Margin="{StaticResource AriaSpace2}" VerticalAlignment="Top" AutomationProperties.Name="Main menu" ToolTipService.ToolTip="Main menu (Alt)">
                        <DropDownButton.Content><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" /></DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutSubItem x:Name="TransferMenu" Text="Transfer actions" IsEnabled="False">
                                    <MenuFlyoutItem Text="Resume" KeyboardAcceleratorTextOverride="Space" Command="{x:Bind ViewModel.BatchResumeCommand}" /><MenuFlyoutItem Text="Pause" KeyboardAcceleratorTextOverride="Space" Command="{x:Bind ViewModel.BatchPauseCommand}" />
                                    <MenuFlyoutItem Text="Retry" Command="{x:Bind ViewModel.BatchRetryCommand}" /><MenuFlyoutItem Text="Recover" Command="{x:Bind ViewModel.BatchRecoverCommand}" />
                                    <MenuFlyoutSeparator /><MenuFlyoutItem Text="Move earlier in queue" Click="SingleActionClick" Tag="MoveUp" /><MenuFlyoutItem Text="Move later in queue" Click="SingleActionClick" Tag="MoveDown" />
                                    <MenuFlyoutSeparator /><MenuFlyoutItem Text="Stop transfer (keep files and history)" Command="{x:Bind ViewModel.BatchRemoveCommand}" />
                                    <MenuFlyoutItem Text="Open file" Click="SingleActionClick" Tag="OpenFile" /><MenuFlyoutItem Text="Open folder" Click="SingleActionClick" Tag="OpenFolder" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem Text="View"><ToggleMenuFlyoutItem x:Name="DetailsToggle" Text="Details pane" IsChecked="True" Click="DetailsClick" /><MenuFlyoutItem x:Name="InspectorDetailsMenu" Text="Transfer details…" IsEnabled="False" Click="InspectorDetailsClick" /><MenuFlyoutItem Text="Columns..." Click="ColumnsClick" /><MenuFlyoutItem Text="Reset pane sizes" Click="ResetPanesClick" /></MenuFlyoutSubItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem Text="Tools"><MenuFlyoutItem Text="Select all visible" KeyboardAcceleratorTextOverride="Ctrl+A" Click="SelectAllClick" /><MenuFlyoutItem Text="Clear selection" Click="ClearSelectionClick" /></MenuFlyoutSubItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem x:Name="HelpMenu" Text="Help"><MenuFlyoutItem Text="Keyboard shortcuts" Click="HelpClick" /><MenuFlyoutItem Text="About AriaGUI" Click="AboutMenuClick" /><MenuFlyoutSeparator /><MenuFlyoutItem Text="Exit" KeyboardAcceleratorTextOverride="Alt+F4" Click="ExitClick" /></MenuFlyoutSubItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <downloads:DownloadsToolbar x:Name="DownloadsToolbarControl" Grid.Column="1" AddRequested="AddClick" FiltersRequested="FiltersClick" SizeChanged="ShellSizeChanged" />
                </Grid>
                <downloads:SelectionBar x:Name="SelectionBarControl" Grid.Row="1" Visibility="Collapsed" SingleActionRequested="SingleActionClick" />
                <downloads:EngineBanner x:Name="EngineBannerControl" Grid.Row="2" />
                <ScrollViewer x:Name="NoticeScroller" Grid.Row="3" MaxHeight="120" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock x:Name="BatchMessageText" TextWrapping="Wrap" Text="{x:Bind ViewModel.BatchMessage, Mode=OneWay}" FontSize="{StaticResource AriaMinimumFontSize}" Margin="{StaticResource AriaRowPadding}" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="BatchDetailsButton" Content="Batch results..." Click="BatchDetailsClick" Visibility="Collapsed" HorizontalAlignment="Left" Margin="{StaticResource AriaSpace2}" Style="{StaticResource AriaSecondaryButtonStyle}" />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasCompletion, Mode=OneWay}" Severity="Success" IsClosable="True" Message="{x:Bind ViewModel.CompletionMessage, Mode=OneWay}" />
                </StackPanel></ScrollViewer>
                <Grid x:Name="TransferWorkspace" Grid.Row="4" SizeChanged="WorkspaceSizeChanged">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition x:Name="DetailsGripRow" Height="6" /><RowDefinition x:Name="DetailsRow" Height="180" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DetailsGripColumn" Width="0" /><ColumnDefinition x:Name="DetailsColumn" Width="0" /></Grid.ColumnDefinitions>
                    <Grid x:Name="HistoryBar" Grid.ColumnSpan="3" Padding="{StaticResource AriaRowPadding}" ColumnSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.BrowserMessage, Mode=OneWay}" FontSize="{StaticResource AriaMinimumFontSize}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind ViewModel.BrowserMessage, Mode=OneWay}" />
                        <StackPanel x:Name="HistoryActions" Grid.Column="1" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ViewModel.IsHistoryView, Mode=OneWay}">
                            <Button Content="‹" Command="{x:Bind ViewModel.PreviousPageCommand}" Style="{StaticResource AriaToolbarButtonStyle}" AutomationProperties.Name="Previous history page" />
                            <Button Content="›" Command="{x:Bind ViewModel.NextPageCommand}" Style="{StaticResource AriaToolbarButtonStyle}" AutomationProperties.Name="Next history page" />
                            <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshHistoryCommand}" Style="{StaticResource AriaToolbarButtonStyle}" AutomationProperties.Name="Refresh history" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="TransferListHost" Grid.Row="1"><downloads:DownloadsTable x:Name="DownloadsTableControl" /><downloads:EmptyState x:Name="EmptyStateControl" /></Grid>
                    <Thumb Grid.Row="2" x:Name="DetailsSplitter" IsTabStop="True" UseSystemFocusVisuals="True" DragDelta="DetailsDragDelta" KeyDown="DetailsKeyDown" AutomationProperties.Name="Resize details pane; use up and down arrows" AutomationProperties.HelpText="Preferred details height in device-independent pixels" Background="{ThemeResource AriaBorderBrush}">
                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" /></ControlTemplate></Thumb.Template>
                    </Thumb>
                    <downloads:DetailsPane x:Name="DetailsPaneControl" Grid.Row="3" SingleActionRequested="SingleActionClick" />
                </Grid>
                <downloads:StatusBar x:Name="StatusBarControl" Grid.Row="5" EngineRequested="EngineClick" />
            </Grid>
            <downloads:HandoffToast x:Name="HandoffToastControl" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
            <ContentControl x:Name="SettingsHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
        </Border>
    </Grid>
</Page>

