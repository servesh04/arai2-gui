<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="AriaRadiusOuter">12</x:Double>
    <x:Double x:Key="AriaRadiusControl">6</x:Double>
    <CornerRadius x:Key="AriaOuterCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="AriaControlCornerRadius">6</CornerRadius>
    <Thickness x:Key="AriaSpace1">4</Thickness>
    <Thickness x:Key="AriaSpace2">8</Thickness>
    <Thickness x:Key="AriaSpace3">12</Thickness>
    <Thickness x:Key="AriaSpace4">16</Thickness>
    <Thickness x:Key="AriaSpace5">20</Thickness>
    <Thickness x:Key="AriaSpace6">24</Thickness>
    <Thickness x:Key="AriaSpace8">32</Thickness>
    <x:Double x:Key="AriaRowHeightComfortable">40</x:Double>
    <x:Double x:Key="AriaRowHeightCompact">32</x:Double>
    <x:Double x:Key="AriaFontSizePrimary">14</x:Double>
    <x:Double x:Key="AriaFontSizeMetadata">12</x:Double>
    <x:Double x:Key="AriaMinimumFontSize">12</x:Double>
    <Thickness x:Key="AriaRowPadding">8,4</Thickness>
    <x:Double x:Key="AriaSectionGap">20</x:Double>
    <x:Double x:Key="AriaIconSizeSmall">16</x:Double>
    <x:Double x:Key="AriaIconSizeMedium">20</x:Double>
    <x:Double x:Key="AriaIconSizeLarge">24</x:Double>
    <x:Double x:Key="AriaProgressThickness">4</x:Double>
    <x:Double x:Key="AriaHeaderSeparatorThickness">1</x:Double>
    <x:Double x:Key="AriaControlTargetSize">32</x:Double>
    <x:Double x:Key="AriaSelectedIndicatorWidth">3</x:Double>
    <x:Double x:Key="AriaTableResizeHitTarget">8</x:Double>
    <x:Double x:Key="AriaShortTransferWorkspaceHeight">520</x:Double>
    <x:Double x:Key="AriaShortTransferDetailsHeight">180</x:Double>
    <x:Double x:Key="AriaShortTransferTableMinimumHeight">160</x:Double>
    <x:Double x:Key="AriaMotionSelectionEnterMilliseconds">120</x:Double>
    <x:Double x:Key="AriaMotionInspectorMilliseconds">160</x:Double>
    <x:Double x:Key="AriaMotionPageEntryMilliseconds">140</x:Double>
    <x:Double x:Key="AriaMotionToastEnterMilliseconds">160</x:Double>
    <x:Double x:Key="AriaMotionToastExitMilliseconds">100</x:Double>
    <x:Double x:Key="AriaMotionToastOffsetY">4</x:Double>
    <x:Double x:Key="AriaMotionDialogMilliseconds">170</x:Double>
    <Thickness x:Key="AriaFocusRingThickness">2</Thickness>
    <Thickness x:Key="AriaStandardBorderThickness">1</Thickness>
    <Thickness x:Key="AriaPrimaryButtonPadding">12,6</Thickness>
    <Thickness x:Key="AriaSecondaryButtonPadding">10,5</Thickness>
    <Thickness x:Key="AriaToolbarButtonPadding">8,5</Thickness>
    <Thickness x:Key="AriaStatusPillPadding">6,2</Thickness>
    <Thickness x:Key="AriaCardPadding">12</Thickness>
    <Thickness x:Key="AriaSelectedRailMargin">0,8</Thickness>

    <Style x:Key="AriaBodyTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AriaTextBodyBrush}" />
        <Setter Property="FontSize" Value="{StaticResource AriaFontSizePrimary}" />
    </Style>
    <Style x:Key="AriaFilenameTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AriaBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AriaTextFilenameBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="AriaMetadataTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AriaTextMetadataBrush}" />
        <Setter Property="FontSize" Value="{StaticResource AriaFontSizeMetadata}" />
    </Style>
    <Style x:Key="AriaQuietDividerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AriaQuietDividerBrush}" />
        <Setter Property="Height" Value="{StaticResource AriaHeaderSeparatorThickness}" />
    </Style>
    <Style x:Key="AriaTableHeaderSeparatorStyle" TargetType="Border" BasedOn="{StaticResource AriaQuietDividerStyle}" />
    <Style x:Key="AriaTableColumnResizeGripStyle" TargetType="Thumb">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="GripVisual" Width="{StaticResource AriaHeaderSeparatorThickness}"
                                Background="{ThemeResource AriaQuietDividerBrush}" HorizontalAlignment="Center" />
                        <Border x:Name="GripFocus" BorderBrush="{ThemeResource AriaFocusRingBrush}"
                                BorderThickness="{StaticResource AriaFocusRingThickness}" IsHitTestVisible="False" Visibility="Collapsed" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"><VisualState.Setters><Setter Target="GripVisual.Background" Value="{ThemeResource AriaQuietDividerBrush}" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="GripVisual.Background" Value="{ThemeResource AriaAccentBrush}" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="GripVisual.Background" Value="{ThemeResource AriaAccentBrush}" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="GripFocus.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="PointerFocused"><VisualState.Setters><Setter Target="GripFocus.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AriaPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AriaAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AriaAccentTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AriaAccentBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource AriaControlCornerRadius}" />
        <Setter Property="FontSize" Value="{StaticResource AriaMinimumFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="{StaticResource AriaControlTargetSize}" />
        <Setter Property="Padding" Value="{StaticResource AriaPrimaryButtonPadding}" />
    </Style>
    <Style x:Key="AriaSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AriaSurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AriaTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AriaBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource AriaStandardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource AriaControlCornerRadius}" />
        <Setter Property="FontSize" Value="{StaticResource AriaMinimumFontSize}" />
        <Setter Property="MinHeight" Value="{StaticResource AriaControlTargetSize}" />
        <Setter Property="Padding" Value="{StaticResource AriaSecondaryButtonPadding}" />
    </Style>
    <Style x:Key="AriaToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource AriaSecondaryButtonStyle}">
        <Setter Property="MinWidth" Value="{StaticResource AriaControlTargetSize}" />
        <Setter Property="Padding" Value="{StaticResource AriaToolbarButtonPadding}" />
    </Style>
    <Style x:Key="AriaStatusPillStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource AriaBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource AriaStandardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource AriaControlCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource AriaStatusPillPadding}" />
    </Style>
    <Style x:Key="AriaCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AriaSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AriaBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource AriaStandardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource AriaOuterCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource AriaCardPadding}" />
    </Style>
    <Style x:Key="AriaDividerStyle" TargetType="Border" BasedOn="{StaticResource AriaQuietDividerStyle}" />
    <Style x:Key="AriaSidebarToggleStyle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="{StaticResource AriaRowHeightComfortable}" />
        <Setter Property="Padding" Value="{StaticResource AriaSpace2}" />
        <Setter Property="Foreground" Value="{ThemeResource AriaTextBodyBrush}" />
        <Setter Property="FontSize" Value="{StaticResource AriaMinimumFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="{ThemeResource AriaBackgroundBrush}">
                        <Border x:Name="HoverFill" Background="{ThemeResource AriaHoverBrush}" CornerRadius="{StaticResource AriaControlCornerRadius}" Visibility="Collapsed" />
                        <Border x:Name="SelectedFill" Background="{ThemeResource AriaSelectedBackgroundBrush}" CornerRadius="{StaticResource AriaControlCornerRadius}" Visibility="Collapsed" />
                        <Border x:Name="SelectedRail" Background="{ThemeResource AriaSelectedIndicatorBrush}" Width="{StaticResource AriaSelectedIndicatorWidth}" HorizontalAlignment="Left" Margin="{StaticResource AriaSelectedRailMargin}" Visibility="Collapsed" />
                        <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        <Border x:Name="FocusRing" BorderBrush="{ThemeResource AriaFocusRingBrush}" BorderThickness="{StaticResource AriaFocusRingThickness}" CornerRadius="{StaticResource AriaControlCornerRadius}" IsHitTestVisible="False" Visibility="Collapsed" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"><VisualState.Setters><Setter Target="HoverFill.Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverFill.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HoverFill.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked"><VisualState.Setters><Setter Target="SelectedFill.Visibility" Value="Collapsed" /><Setter Target="SelectedRail.Visibility" Value="Collapsed" /><Setter Target="Content.Foreground" Value="{ThemeResource AriaTextBodyBrush}" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="SelectedFill.Visibility" Value="Visible" /><Setter Target="SelectedRail.Visibility" Value="Visible" /><Setter Target="Content.Foreground" Value="{ThemeResource AriaSelectedForegroundBrush}" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Indeterminate"><VisualState.Setters><Setter Target="SelectedFill.Visibility" Value="Visible" /><Setter Target="SelectedRail.Visibility" Value="Visible" /><Setter Target="Content.Foreground" Value="{ThemeResource AriaSelectedForegroundBrush}" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="FocusRing.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="PointerFocused"><VisualState.Setters><Setter Target="FocusRing.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AriaSidebarFilterStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="{StaticResource AriaRowHeightComfortable}" />
        <Setter Property="Padding" Value="{StaticResource AriaSpace2}" />
        <Setter Property="Foreground" Value="{ThemeResource AriaTextBodyBrush}" />
        <Setter Property="FontSize" Value="{StaticResource AriaMinimumFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid Background="{ThemeResource AriaBackgroundBrush}">
                        <Border x:Name="HoverFill" Background="{ThemeResource AriaHoverBrush}" CornerRadius="{StaticResource AriaControlCornerRadius}" Visibility="Collapsed" />
                        <Border x:Name="SelectedFill" Background="{ThemeResource AriaSelectedBackgroundBrush}" CornerRadius="{StaticResource AriaControlCornerRadius}" Visibility="Collapsed" />
                        <Border x:Name="SelectedRail" Background="{ThemeResource AriaSelectedIndicatorBrush}" Width="{StaticResource AriaSelectedIndicatorWidth}" HorizontalAlignment="Left" Margin="{StaticResource AriaSelectedRailMargin}" Visibility="Collapsed" />
                        <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        <Border x:Name="FocusRing" BorderBrush="{ThemeResource AriaFocusRingBrush}" BorderThickness="{StaticResource AriaFocusRingThickness}" CornerRadius="{StaticResource AriaControlCornerRadius}" IsHitTestVisible="False" Visibility="Collapsed" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"><VisualState.Setters><Setter Target="HoverFill.Visibility" Value="Collapsed" /><Setter Target="SelectedFill.Visibility" Value="Collapsed" /><Setter Target="SelectedRail.Visibility" Value="Collapsed" /><Setter Target="Content.Foreground" Value="{ThemeResource AriaTextBodyBrush}" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverFill.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HoverFill.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="SelectedFill.Visibility" Value="Visible" /><Setter Target="SelectedRail.Visibility" Value="Visible" /><Setter Target="Content.Foreground" Value="{ThemeResource AriaSelectedForegroundBrush}" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="SelectedPointerOver"><VisualState.Setters><Setter Target="SelectedFill.Visibility" Value="Visible" /><Setter Target="SelectedRail.Visibility" Value="Visible" /><Setter Target="Content.Foreground" Value="{ThemeResource AriaSelectedForegroundBrush}" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="SelectedPressed"><VisualState.Setters><Setter Target="SelectedFill.Visibility" Value="Visible" /><Setter Target="SelectedRail.Visibility" Value="Visible" /><Setter Target="Content.Foreground" Value="{ThemeResource AriaSelectedForegroundBrush}" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="FocusRing.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="PointerFocused"><VisualState.Setters><Setter Target="FocusRing.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
