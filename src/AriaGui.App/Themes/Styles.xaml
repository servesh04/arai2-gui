<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="AriaRadiusOuter">12</x:Double>
    <x:Double x:Key="AriaRadiusControl">6</x:Double>
    <CornerRadius x:Key="AriaOuterCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="AriaControlCornerRadius">6</CornerRadius>
    <Thickness x:Key="AriaSpace1">4</Thickness>
    <Thickness x:Key="AriaSpace2">8</Thickness>
    <Thickness x:Key="AriaSpace3">12</Thickness>
    <Thickness x:Key="AriaSpace4">16</Thickness>
    <Thickness x:Key="AriaSpace5">20</Thickness>
    <Thickness x:Key="AriaSpace6">24</Thickness>
    <Thickness x:Key="AriaSpace8">32</Thickness>
    <x:Double x:Key="AriaRowHeightComfortable">40</x:Double>
    <x:Double x:Key="AriaRowHeightCompact">32</x:Double>
    <x:Double x:Key="AriaMinimumFontSize">12</x:Double>

    <Style x:Key="AriaPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AriaAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AriaAccentTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AriaAccentBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource AriaControlCornerRadius}" />
        <Setter Property="FontSize" Value="{StaticResource AriaMinimumFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style x:Key="AriaSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AriaSurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AriaTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AriaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AriaControlCornerRadius}" />
        <Setter Property="FontSize" Value="{StaticResource AriaMinimumFontSize}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style x:Key="AriaToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource AriaSecondaryButtonStyle}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style x:Key="AriaStatusPillStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource AriaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AriaControlCornerRadius}" />
        <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style x:Key="AriaCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AriaSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AriaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AriaOuterCornerRadius}" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="AriaDividerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AriaBorderBrush}" />
        <Setter Property="Height" Value="1" />
    </Style>
</ResourceDictionary>
