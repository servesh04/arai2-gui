<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AriaBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
    <SolidColorBrush x:Key="AriaSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
    <SolidColorBrush x:Key="AriaSurfaceRaisedBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
    <SolidColorBrush x:Key="AriaBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    <SolidColorBrush x:Key="AriaTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    <SolidColorBrush x:Key="AriaTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    <SolidColorBrush x:Key="AriaTextDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
    <SolidColorBrush x:Key="AriaAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
    <SolidColorBrush x:Key="AriaAccentTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
    <SolidColorBrush x:Key="AriaSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    <SolidColorBrush x:Key="AriaWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    <SolidColorBrush x:Key="AriaDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    <SolidColorBrush x:Key="AriaFocusRingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
    <SolidColorBrush x:Key="AriaSelectionTintBrush" Color="{ThemeResource SystemColorHighlightColor}" />
</ResourceDictionary>
