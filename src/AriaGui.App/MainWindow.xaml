<Window x:Class="AriaGui.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AriaGUI">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="AriaGUI" Subtitle="Close to tray · Exit to stop" />
        <ContentControl x:Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <TextBlock x:Name="DesktopStatus" Grid.Row="2" Visibility="Collapsed" Margin="10,5" TextWrapping="Wrap" FontSize="12" />
    </Grid>
</Window>
