<Application x:Class="AriaGui.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default" Source="Themes/Tokens.Dark.xaml" />
                <ResourceDictionary x:Key="Dark" Source="Themes/Tokens.Dark.xaml" />
                <ResourceDictionary x:Key="Light" Source="Themes/Tokens.Light.xaml" />
                <ResourceDictionary x:Key="HighContrast" Source="Themes/Tokens.HighContrast.xaml" />
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
