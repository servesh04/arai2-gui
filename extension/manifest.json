{
  "manifest_version": 3,
  "name": "AriaGUI Download Handoff",
  "version": "0.1.0",
  "description": "Send browser downloads to AriaGUI when it is ready.",
  "key": "",
  "permissions": ["downloads", "nativeMessaging", "cookies", "storage", "contextMenus", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": "icons/32.png" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["clicks.js"], "run_at": "document_start" }]
}
