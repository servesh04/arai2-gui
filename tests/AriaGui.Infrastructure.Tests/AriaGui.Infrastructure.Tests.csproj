<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <ProjectReference Include="../../src/AriaGui.Infrastructure/AriaGui.Infrastructure.csproj" />
    <ProjectReference Include="../AriaGui.EngineFixture/AriaGui.EngineFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/AriaGui.NativeHost/AriaGui.NativeHost.csproj" ReferenceOutputAssembly="false" />
    <Content Include="../../vendor/aria2/win-x64/aria2c.exe" Link="Engine/aria2c.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ChecksumFixture/m2-synthetic.bin" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
  </ItemGroup>
  <Target Name="CopyEngineFixture" AfterTargets="Build">
    <MSBuild Projects="../AriaGui.EngineFixture/AriaGui.EngineFixture.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform)" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="FixtureAssembly" />
    </MSBuild>
    <PropertyGroup><FixtureOutputDirectory>@(FixtureAssembly->'%(RootDir)%(Directory)')</FixtureOutputDirectory></PropertyGroup>
    <ItemGroup><FixtureFiles Include="$(FixtureOutputDirectory)**/*" /></ItemGroup>
    <Copy SourceFiles="@(FixtureFiles)" DestinationFiles="@(FixtureFiles->'$(OutDir)Fixtures/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="CopyNativeHostFixture" AfterTargets="Build">
    <MSBuild Projects="../../src/AriaGui.NativeHost/AriaGui.NativeHost.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform)" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="NativeHostAssembly" />
    </MSBuild>
    <PropertyGroup><NativeHostOutputDirectory>@(NativeHostAssembly->'%(RootDir)%(Directory)')</NativeHostOutputDirectory></PropertyGroup>
    <ItemGroup><NativeHostFiles Include="$(NativeHostOutputDirectory)**/*" /></ItemGroup>
    <Copy SourceFiles="@(NativeHostFiles)" DestinationFiles="@(NativeHostFiles->'$(OutDir)NativeHostFixture/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
